---
import type { Locale } from '../data/site';
import { timeline } from '../data/experience';
interface Props { lang: Locale; }
const { lang } = Astro.props;
const ui = {
  en: { eyebrow:'Career timeline', title:'A career in public institutions', lede:'Month-accurate roles from 2003 to the present. Overlaps are real; education is shown separately.', career:'Professional experience', education:'Graduate education', hint:'Select a bar to inspect that chapter of the trajectory.', start:'Start', end:'End', role:'Role', institution:'Institution', result:'Contribution', table:'View timeline as a table', present:'Present', close:'Close', visit:'Visit institution' },
  pt: { eyebrow:'Linha do tempo profissional', title:'Uma trajetória em instituições públicas', lede:'Funções com precisão mensal de 2003 ao presente. As sobreposições são reais; a formação aparece separadamente.', career:'Experiência profissional', education:'Formação acadêmica', hint:'Selecione uma faixa para examinar este capítulo da trajetória.', start:'Início', end:'Fim', role:'Função', institution:'Instituição', result:'Contribuição', table:'Ver linha do tempo como tabela', present:'Presente', close:'Fechar', visit:'Visitar instituição' },
  es: { eyebrow:'Trayectoria profesional', title:'Una carrera en instituciones públicas', lede:'Funciones con precisión mensual desde 2003 hasta el presente. Las superposiciones son reales; la formación aparece por separado.', career:'Experiencia profesional', education:'Formación académica', hint:'Selecciona una barra para examinar este capítulo de la trayectoria.', start:'Inicio', end:'Fin', role:'Función', institution:'Institución', result:'Contribución', table:'Ver cronología como tabla', present:'Presente', close:'Cerrar', visit:'Visitar institución' },
  it: { eyebrow:'Percorso professionale', title:'Una carriera nelle istituzioni pubbliche', lede:'Ruoli con precisione mensile dal 2003 a oggi. Le sovrapposizioni sono reali; la formazione è mostrata separatamente.', career:'Esperienza professionale', education:'Formazione accademica', hint:'Seleziona una barra per esaminare questo capitolo del percorso.', start:'Inizio', end:'Fine', role:'Ruolo', institution:'Istituzione', result:'Contributo', table:'Vedi cronologia come tabella', present:'Presente', close:'Chiudi', visit:'Visita istituzione' }
}[lang];
const origin = 2003 * 12;
const rangeEnd = 2026 * 12 + 8;
const total = rangeEnd - origin + 1;
const month = (value: string) => { const [year, part] = value.split('-').map(Number); return year * 12 + part - 1; };
const fmt = (value: string | null) => value ? new Intl.DateTimeFormat(lang, { month:'short', year:'numeric', timeZone:'UTC' }).format(new Date(`${value}-01T00:00:00Z`)) : ui.present;
const tableRows = timeline.map((entry) => ({ ...entry, institutionText: entry.institution[lang], roleText: entry.role[lang], resultText: entry.result[lang] }));

const stints = Object.values(
  timeline.reduce<Record<string, typeof timeline>>((acc, entry) => {
    const key = entry.stintId ?? entry.id;
    (acc[key] ??= []).push(entry);
    return acc;
  }, {})
).map((entries) => {
  const sorted = [...entries].sort((a, b) => month(a.start) - month(b.start));
  const first = sorted[0];
  const ongoing = sorted.some((entry) => entry.end === null);
  const start = sorted[0].start;
  const end = ongoing ? null : sorted.reduce((latest, entry) => (entry.end && month(entry.end) > month(latest) ? entry.end : latest), sorted[0].end as string);
  const left = (month(start) - origin) / total * 100;
  const last = end ? month(end) : rangeEnd;
  const width = Math.max((last - month(start) + 1) / total * 100, .7);
  const stops = sorted.map((entry) => ({ role: entry.role[lang], date: `${fmt(entry.start)} – ${fmt(entry.end)}`, result: entry.result[lang], url: entry.url }));
  return {
    group: first.group,
    institution: first.institution[lang],
    left, width,
    ongoing,
    date: `${fmt(start)} – ${fmt(end)}`,
    stops
  };
});
const ticks = [2003, 2006, 2009, 2012, 2015, 2018, 2021, 2024, 2026];
---
<section class="timeline section-shell reveal" id="career-timeline" aria-labelledby="timeline-title">
  <div class="figure gantt-figure">
    <p class="eyebrow">{ui.eyebrow}</p><h2 id="timeline-title">{ui.title}</h2><p class="lede">{ui.lede}</p>
    <div class="gantt-scroll" tabindex="0" aria-label={ui.title}>
      <div class="gantt" style={`--today:${(rangeEnd-origin)/total*100}%`}>
        <div class="gantt-axis gantt-top"><span></span><div>{ticks.map((year) => <i style={`--x:${((year*12-origin)/total*100).toFixed(3)}%`}>{year}</i>)}</div></div>
        {(['career','education'] as const).map((group) => <div class="gantt-group">
          <h3>{group === 'career' ? ui.career : ui.education}</h3>
          {stints.filter((stint) => stint.group === group).map((stint) => <div class="gantt-row">
            <div class="gantt-label"><strong>{stint.institution}</strong><span>{stint.stops[0].role}{stint.stops.length > 1 ? ` +${stint.stops.length - 1}` : ''}</span></div>
            <div class="gantt-track">{ticks.map((year) => <i class="gantt-gridline" style={`--x:${((year*12-origin)/total*100).toFixed(3)}%`}></i>)}<button class:list={['gantt-bar', { current: stint.ongoing, education: stint.group === 'education' }]} style={`--left:${stint.left.toFixed(3)}%;--width:${stint.width.toFixed(3)}%`} type="button" aria-pressed="false" aria-label={`${stint.institution}, ${stint.stops[0].role}, ${stint.date}`} data-gantt={JSON.stringify({ institution:stint.institution, date:stint.date, stops:stint.stops })}></button></div>
          </div>)}
        </div>)}
        <div class="gantt-axis"><span></span><div>{ticks.map((year) => <i style={`--x:${((year*12-origin)/total*100).toFixed(3)}%`}>{year}</i>)}</div></div>
      </div>
    </div>
    <div class="gantt-info" id="ganttInfo" aria-live="polite">{ui.hint}</div>
    <details class="table-alternative"><summary>{ui.table}</summary><div class="table-scroll"><table><thead><tr><th>{ui.institution}</th><th>{ui.role}</th><th>{ui.start}</th><th>{ui.end}</th><th>{ui.result}</th></tr></thead><tbody>{tableRows.map((row) => <tr><th>{row.institutionText}</th><td>{row.roleText}</td><td>{fmt(row.start)}</td><td>{fmt(row.end)}</td><td>{row.resultText}</td></tr>)}</tbody></table></div></details>
  </div>
</section>
<dialog class="timeline-modal" id="timelineModal" aria-labelledby="timelineModalTitle"><div><button class="modal-close" type="button" data-close-timeline aria-label={ui.close}>×</button><p class="eyebrow">{ui.eyebrow}</p><h2 id="timelineModalTitle"></h2><div id="timelineModalStops"></div></div></dialog>
<script is:inline define:vars={{ visitLabel: ui.visit }}>
  const ganttButtons = [...document.querySelectorAll('[data-gantt]')];
  const ganttInfo = document.getElementById('ganttInfo');
  const timelineDialog = document.getElementById('timelineModal');
  const escapeHtml = (value) => String(value).replace(/[&<>"']/g, (ch) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[ch]));
  const showTimeline = (button) => {
    const data = JSON.parse(button.dataset.gantt);
    ganttButtons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
    const stopsHtml = data.stops.map((stop) => `
      <p class="modal-role">${escapeHtml(stop.role)} · ${escapeHtml(stop.date)}</p>
      <p>${escapeHtml(stop.result)}</p>
      ${stop.url ? `<a class="text-link" href="${escapeHtml(stop.url)}" target="_blank" rel="noreferrer">${escapeHtml(visitLabel)} ↗</a>` : ''}
    `).join('');
    ganttInfo.innerHTML = `<strong>${escapeHtml(data.institution)}</strong><span>${escapeHtml(data.date)}</span>${stopsHtml}`;
    document.getElementById('timelineModalTitle').textContent = data.institution;
    document.getElementById('timelineModalStops').innerHTML = stopsHtml;
    timelineDialog.showModal();
  };
  ganttButtons.forEach((button, index) => {
    button.addEventListener('click', () => showTimeline(button));
    button.addEventListener('keydown', (event) => {
      if (!['ArrowUp','ArrowDown'].includes(event.key)) return;
      event.preventDefault(); ganttButtons[(index + (event.key === 'ArrowDown' ? 1 : -1) + ganttButtons.length) % ganttButtons.length].focus();
    });
  });
  document.querySelector('[data-close-timeline]')?.addEventListener('click', () => timelineDialog.close());
  timelineDialog?.addEventListener('click', (event) => { if (event.target === timelineDialog) timelineDialog.close(); });
</script>
