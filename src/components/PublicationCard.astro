---
import { statusLabel, typeLabel, type WorkItem } from '../data/catalog';
import type { Locale } from '../data/site';
import { withBase } from '../data/paths';
interface Props { item: WorkItem; lang: Locale; }
const { item, lang } = Astro.props;
const labels = {
  en: { view:'Open document', language:'Document language' }, pt: { view:'Abrir documento', language:'Idioma do documento' },
  es: { view:'Abrir documento', language:'Idioma del documento' }, it: { view:'Apri documento', language:'Lingua del documento' }
}[lang];
const primary = item.verifiedLinks[0];
const internal = primary?.href.startsWith('/');
const href = primary ? (internal ? withBase(primary.href) : primary.href) : undefined;
const external = { target: '_blank', rel: 'noopener noreferrer' };
---
<article class="publication-card card reveal" data-category={item.category} data-status={item.statusCode} data-language={item.languages.join(' ')}>
  <p class="eyebrow">{typeLabel(item, lang)} · {item.year}</p>
  <h3>{href ? <a href={href} {...external}>{item.title}</a> : item.title}</h3>
  <p>{item.localizedSummary[lang]}</p>
  <div class="card-meta"><span>{statusLabel(item, lang)}</span><span>{labels.language}: {item.languages.map((value: string) => value.toUpperCase()).join(' · ')}</span></div>
  {href && <a class="worklink" href={href} {...external}>{labels.view} ↗</a>}
</article>
