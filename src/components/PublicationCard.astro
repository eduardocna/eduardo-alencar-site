---
import { statusLabel, typeLabel, type WorkItem } from '../data/catalog';
import type { Locale } from '../data/site';
import { workPath } from '../data/paths';
interface Props { item: WorkItem; lang: Locale; }
const { item, lang } = Astro.props;
const labels = {
  en: { view:'View work', language:'Document language' }, pt: { view:'Ver trabalho', language:'Idioma do documento' },
  es: { view:'Ver trabajo', language:'Idioma del documento' }, it: { view:'Vedi lavoro', language:'Lingua del documento' }
}[lang];
---
<article class="publication-card card reveal" data-category={item.category} data-status={item.statusCode} data-language={item.languages.join(' ')}>
  <p class="eyebrow">{typeLabel(item, lang)} · {item.year}</p>
  <h3><a href={workPath(lang, item.slug)}>{item.title}</a></h3>
  <p>{item.localizedSummary[lang]}</p>
  <div class="card-meta"><span>{statusLabel(item, lang)}</span><span>{labels.language}: {item.languages.map((value: string) => value.toUpperCase()).join(' · ')}</span></div>
  <a class="worklink" href={workPath(lang, item.slug)}>{labels.view} →</a>
</article>
