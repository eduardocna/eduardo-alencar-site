---
import type { Locale } from '../data/site';
import { linkedInMetrics } from '../data/linkedinMetrics';

interface Props { lang: Locale; }
const { lang } = Astro.props;
---
<section class="verified-scale section-shell reveal" aria-label="LinkedIn">
  {linkedInMetrics.map((metric) => <div><strong>{metric.value}</strong><span>{metric.label[lang]}</span></div>)}
</section>
