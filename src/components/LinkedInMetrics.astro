---
import type { Locale } from '../data/site';
import { linkedInMetrics } from '../data/linkedinMetrics';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const numeric = (value: string) => /^[\d.,]+$/.test(value) ? value.replace(/[.,]/g, '') : undefined;
---
<section class="verified-scale li-metrics section-shell reveal" aria-label="LinkedIn" data-li-metrics>
  {linkedInMetrics.map((metric) => <div><strong data-li-count={numeric(metric.value)} data-display={metric.value}>{metric.value}</strong><span>{metric.label[lang]}</span></div>)}
</section>

<style is:global>
  .li-metrics>div{position:relative}
  .li-metrics>div:has([data-li-count])::after{content:"";position:absolute;left:0;bottom:-1px;width:100%;height:2px;background:linear-gradient(90deg,var(--blue),var(--mint),var(--orange));transform:scaleX(var(--li-progress,1));transform-origin:left}
  .li-metrics strong{font-variant-numeric:tabular-nums}
</style>

<script is:inline>
  (() => {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll('[data-li-metrics]').forEach((section) => {
      const nodes = [...section.querySelectorAll('[data-li-count]')];
      if (reduced || !nodes.length || !('IntersectionObserver' in window)) return;
      const separator = nodes[0].dataset.display.match(/[.,]/)?.[0] ?? ',';
      const format = (n) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, separator);
      const run = () => nodes.forEach((node, i) => {
        const target = Number(node.dataset.liCount);
        const cell = node.parentElement;
        const duration = 1600;
        const start = performance.now() + i * 180;
        node.textContent = format(0);
        cell.style.setProperty('--li-progress', '0');
        const frame = (now) => {
          const p = Math.max(0, Math.min(1, (now - start) / duration));
          const eased = 1 - Math.pow(1 - p, 4);
          node.textContent = p === 1 ? node.dataset.display : format(Math.round(target * eased));
          cell.style.setProperty('--li-progress', String(eased));
          if (p < 1) requestAnimationFrame(frame);
          else node.dataset.done = '1';
        };
        requestAnimationFrame(frame);
      });
      const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
        if (entry.isIntersecting) { run(); observer.disconnect(); }
      }), { threshold: 0.35 });
      observer.observe(section);
    });
  })();
</script>
