---
import { copy, documents, sectionIds, type Locale, inline } from '../data/site';
import { publicItems } from '../data/catalog';
interface Props { lang: Locale; }
const { lang } = Astro.props;
const doc = documents[lang]; const ui = copy[lang];
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const pages = doc.sections.map((section, index) => ({ ...section, id: sectionIds[index] }));
const home = pages[0]; const hero = home.blocks[0]?.split('\n').filter(Boolean) ?? [];
const metrics = [['13,042', 'RICs', '72%'], ['30,304', lang === 'pt' ? 'contratações' : lang === 'it' ? 'contratti' : lang === 'es' ? 'contratos' : 'contracts', '92%'], ['32', lang === 'pt' ? 'testes' : lang === 'it' ? 'test' : lang === 'es' ? 'pruebas' : 'tests', '48%']];
const explorer = lang === 'pt' ? [
  { n:'01', t:'Integridade', d:'Microdados de compras transformados em prioridades auditáveis, sem confundir sinal de risco com prova.', fields:[['Escala','30.304 contratos federais'],['Entrega','32 testes e trilha de verificação humana']] },
  { n:'02', t:'Inferência causal', d:'Desenhos contrafactuais para separar mudança institucional de coincidência temporal.', fields:[['Métodos','Controle sintético, DiD e RDD'],['Uso','Reformas, governança e resultados de desenvolvimento']] },
  { n:'03', t:'Fiscalização', d:'Texto como dado para medir se uma resposta respondeu à pergunta, não apenas se chegou no prazo.', fields:[['Base','13.042 pares RIC-resposta'],['Saída','Completude, evidência, atraso e evasão substantiva']] },
  { n:'04', t:'Sistemas de governança', d:'Instrumentação que liga objetivos públicos, decisões e rotinas de acompanhamento.', fields:[['Stack','Python, Airtable, Power BI e APIs'],['Princípio','Transparência metodológica antes de automação']] }
] : lang === 'es' ? [
  { n:'01', t:'Integridad', d:'Microdatos de compras convertidos en prioridades auditables, sin confundir una señal de riesgo con prueba.', fields:[['Escala','30.304 contratos federales'],['Entrega','32 pruebas y verificación humana']] },
  { n:'02', t:'Inferencia causal', d:'Diseños contrafactuales para separar el cambio institucional de la coincidencia temporal.', fields:[['Métodos','Control sintético, DiD y RDD'],['Uso','Reformas, gobernanza y desarrollo']] },
  { n:'03', t:'Control', d:'Texto como datos para medir si una respuesta contestó la pregunta, no solo si llegó a tiempo.', fields:[['Base','13.042 pares solicitud-respuesta'],['Salida','Completitud, evidencia, retraso y evasión']] },
  { n:'04', t:'Sistemas de gobernanza', d:'Instrumentación que conecta objetivos públicos, decisiones y seguimiento.', fields:[['Stack','Python, Airtable, Power BI y APIs'],['Principio','Transparencia metodológica antes de automatizar']] }
] : lang === 'it' ? [
  { n:'01', t:'Integrità', d:'Microdati sugli appalti trasformati in priorità di audit, senza confondere un segnale di rischio con una prova.', fields:[['Scala','30.304 contratti federali'],['Consegna','32 test e verifica umana']] },
  { n:'02', t:'Inferenza causale', d:'Disegni controfattuali per distinguere il cambiamento istituzionale dalla coincidenza temporale.', fields:[['Metodi','Controllo sintetico, DiD e RDD'],['Uso','Riforme, governance e sviluppo']] },
  { n:'03', t:'Controllo', d:'Text-as-data per misurare se una risposta affronta la domanda, non solo se arriva in tempo.', fields:[['Base','13.042 coppie richiesta-risposta'],['Output','Completezza, evidenza, ritardo ed evasione']] },
  { n:'04', t:'Sistemi di governance', d:'Strumentazione che collega obiettivi pubblici, decisioni e routine di monitoraggio.', fields:[['Stack','Python, Airtable, Power BI e API'],['Principio','Trasparenza metodologica prima dell’automazione']] }
] : [
  { n:'01', t:'Integrity', d:'Procurement microdata turned into auditable priorities without confusing a risk signal with proof.', fields:[['Scale','30,304 federal contracts'],['Delivery','32 tests and a human verification trail']] },
  { n:'02', t:'Causal inference', d:'Counterfactual designs that separate institutional change from temporal coincidence.', fields:[['Methods','Synthetic Control, DiD and RDD'],['Use','Reforms, governance and development outcomes']] },
  { n:'03', t:'Oversight', d:'Text-as-data that measures whether a response answered the question, not only whether it arrived on time.', fields:[['Base','13,042 request-response pairs'],['Output','Completeness, evidence, delay and substantive evasion']] },
  { n:'04', t:'Governance systems', d:'Instrumentation that connects public objectives, decisions and monitoring routines.', fields:[['Stack','Python, Airtable, Power BI and APIs'],['Principle','Method transparency before automation']] }
];
const storySteps = lang === 'pt' ? [['Fonte','O registro preserva denominadores, data de extração e procedência.'],['Método','A regra analítica é explícita e reproduzível.'],['Revisão','O algoritmo prioriza, uma pessoa verifica.'],['Decisão','Evidência chega à decisão com seus limites visíveis.']] : lang === 'it' ? [['Fonte','Il record conserva denominatori, data di estrazione e provenienza.'],['Metodo','La regola analitica è esplicita e riproducibile.'],['Revisione','L’algoritmo dà priorità, una persona verifica.'],['Decisione','L’evidenza arriva alla decisione con i propri limiti visibili.']] : lang === 'es' ? [['Fuente','El registro conserva denominadores, fecha de extracción y procedencia.'],['Método','La regla analítica es explícita y reproducible.'],['Revisión','El algoritmo prioriza, una persona verifica.'],['Decisión','La evidencia llega a la decisión con sus límites visibles.']] : [['Source','The record keeps denominators, extraction date and provenance.'],['Method','The analytical rule is explicit and reproducible.'],['Review','The algorithm prioritizes, a person verifies.'],['Decision','Evidence reaches the decision with its limits visible.']];
const timeline = lang === 'pt' ? [['2003','Ipea','Análise de política industrial e inteligência econômica aplicada ao setor público.'],['2013','SAE','Produção de evidências sobre classe média, emprego e capacidade estatal.'],['2015','CGU','Integridade, controle e gestão pública federal.'],['2017','UC Irvine','Início do doutorado em Social Ecology e pesquisa de métodos causais.'],['2021','Doutorado','Tese sobre detecção de fraude em compras públicas brasileiras.'],['2024','Anatel','Direção de assessoria técnica e secretaria executiva do Ceadi.'],['2024','Câmara dos Deputados','Consultoria legislativa sênior: fiscalização, dados e integridade.'],['2026','Fraud Research Group','Colaboração internacional em risco de fraude e compras públicas.']] : lang === 'it' ? [['2003','Ipea','Analisi di politica industriale e intelligenza economica per il settore pubblico.'],['2013','SAE','Evidenza su classe media, lavoro e capacità statale.'],['2015','CGU','Integrità, controllo e gestione pubblica federale.'],['2017','UC Irvine','Inizio del dottorato in Social Ecology e ricerca sui metodi causali.'],['2021','Dottorato','Tesi sul rilevamento delle frodi negli appalti pubblici brasiliani.'],['2024','Anatel','Direzione dell’assistenza tecnica e segreteria esecutiva del Ceadi.'],['2024','Camera dei Deputati','Consulenza legislativa senior: controllo, dati e integrità.'],['2026','Fraud Research Group','Collaborazione internazionale su rischio di frode e appalti pubblici.']] : lang === 'es' ? [['2003','Ipea','Análisis de política industrial e inteligencia económica para el sector público.'],['2013','SAE','Evidencia sobre clase media, empleo y capacidad estatal.'],['2015','CGU','Integridad, control y gestión pública federal.'],['2017','UC Irvine','Inicio del doctorado en Social Ecology y métodos causales.'],['2021','Doctorado','Tesis sobre detección de fraude en compras públicas brasileñas.'],['2024','Anatel','Dirección de asesoría técnica y secretaría ejecutiva del Ceadi.'],['2024','Cámara de Diputados','Asesoría legislativa sénior: control, datos e integridad.'],['2026','Fraud Research Group','Colaboración internacional sobre fraude y compras públicas.']] : [['2003','Ipea','Industrial policy analysis and public-sector economic intelligence.'],['2013','SAE','Evidence on the middle class, work and state capacity.'],['2015','CGU','Public integrity, oversight and federal management.'],['2017','UC Irvine','PhD in Social Ecology and causal-methods research begins.'],['2021','PhD','Dissertation on detecting fraud in Brazilian public procurement.'],['2024','Anatel','Technical advisory leadership and Ceadi executive secretariat.'],['2024','Chamber of Deputies','Senior legislative advisory: oversight, data and integrity.'],['2026','Fraud Research Group','International collaboration on fraud risk and public procurement.']];
const text = { evidence: lang === 'pt' ? 'Evidência → decisão' : lang === 'es' ? 'Evidencia → decisión' : lang === 'it' ? 'Evidenza → decisione' : 'Evidence → action', signal: lang === 'pt' ? 'Sinal não é veredito.' : lang === 'es' ? 'Una señal no es un veredicto.' : lang === 'it' ? 'Un segnale non è un verdetto.' : 'Signal is not a verdict.', explain: lang === 'pt' ? 'Cada afirmação visual permanece ligada a uma fonte, método e caminho de verificação humana.' : lang === 'es' ? 'Cada afirmación visual permanece vinculada a una fuente, método y vía de verificación humana.' : lang === 'it' ? 'Ogni affermazione visiva resta collegata a una fonte, un metodo e un percorso di verifica umana.' : 'Each visual claim remains tied to a source, a method and a human verification path.', all: lang === 'it' ? 'Tutti' : lang === 'en' ? 'All' : 'Todos', publications: lang === 'pt' ? 'Publicações' : lang === 'es' ? 'Publicaciones' : lang === 'it' ? 'Pubblicazioni' : 'Publications' };
const block = (value: string) => { const [heading, ...body] = value.split('\n').filter(Boolean); return { heading: heading.replace(/^## /, ''), body, list: body.filter((line) => line.startsWith('- ')) }; };
---
<div class="scroll-progress" id="scrollProgress" aria-hidden="true"></div>
<dialog class="timeline-modal" id="timelineModal"><div class="timeline-modal-inner"><button class="modal-close" type="button" data-close-dialog aria-label={ui.close}>×</button><p class="eyebrow">{ui.timeline}</p><h2>Eduardo Alencar</h2><p id="timelineModalDetail"></p></div></dialog>
<style is:global>
  .card{position:relative;overflow:hidden;transition:transform .35s cubic-bezier(.2,.8,.2,1),border-color .35s,box-shadow .35s}.card::before{content:"";position:absolute;inset:0;pointer-events:none;opacity:0;background:radial-gradient(360px circle at var(--mx,50%) var(--my,20%),color-mix(in srgb,var(--accent) 14%,transparent),transparent 48%);transition:opacity .3s}.card:hover{transform:translateY(-5px);border-color:var(--accent);box-shadow:0 20px 44px -28px #000}.card:hover::before{opacity:1}.stat strong{font-variant-numeric:tabular-nums}.story-visual{position:sticky;top:104px;min-height:620px}.story-grid{grid-template-columns:repeat(10,1fr);align-content:center}.story-note{position:absolute;top:18px;left:20px;right:20px;z-index:3;font:10px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}.story-center{z-index:2;box-shadow:0 16px 42px -24px #000;padding:18px}.story-center span{display:block;font:10px var(--mono);letter-spacing:.12em;margin-bottom:8px}.story-center b{font-weight:400}.story-legend{position:absolute;bottom:18px;left:20px;right:20px;z-index:2;display:flex;justify-content:center;gap:14px;font:10px var(--mono);letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}.story-step{min-height:52vh;display:flex;flex-direction:column;justify-content:center}.stepno{font:11px var(--mono);color:var(--accent);letter-spacing:.12em}.story-step h3{font:400 30px var(--serif);margin:0}.explorer-detail{display:grid;grid-template-columns:1fr 1fr;gap:20px}.explorer-detail h3,.explorer-detail>p{grid-column:1/-1}.explorer-field{border-top:1px solid var(--rule);padding-top:12px}.explorer-field span{font:10px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}.explorer-field p{margin:4px 0 0}.tl-row{grid-template-columns:76px minmax(150px,.8fr) 1.5fr;transition:background .2s,padding .2s}.tl-row:hover,.tl-row[aria-pressed="true"]{background:var(--surface2);padding-left:12px}.tl-row small{grid-column:2/-1;font:13px/1.45 var(--sans);letter-spacing:0;text-transform:none}.tl-info{margin-top:16px;padding:16px;border:1px solid var(--rule);border-radius:8px;background:var(--surface2);display:grid;gap:5px}.tl-info strong{font:400 22px var(--serif)}.tl-info span{color:var(--muted)}@media(max-width:900px){.story-visual{position:relative;top:0;min-height:400px}.story-step{min-height:auto;padding:44px 0}.explorer-detail{grid-template-columns:1fr}.tl-row{grid-template-columns:58px 1fr}.tl-row i,.tl-row small{grid-column:2}.card:hover{transform:none}}@media(prefers-reduced-motion:reduce){.card,.card::before,.tl-row{transition:none}.card:hover{transform:none}}
</style>

<article class="site-page page on" data-page="home" id="home">
  <section class="hero section-shell"><div class="hero-txt reveal"><p class="eyebrow">{hero[0] ?? 'Eduardo Alencar · PhD · scholar-practitioner'}</p><h1>{hero[1] ?? doc.title}</h1><p class="lede">{hero.slice(2).join(' ')}</p><div class="ctarow"><button class="cta" data-go="research">{ui.read}</button><button class="cta ghost" data-go="tools">{ui.tools}</button><button class="cta ghost" data-go="cv">{ui.cv}</button></div></div><div class="portrait-stage reveal"><span class="orbit-dot"></span><img class="portrait" src={`${base}images/eduardo-alencar.jpg`} alt="Eduardo Alencar" width="212" height="212" /></div></section>
  <section class="ledger section-shell reveal"><div><p class="eyebrow">{ui.metrics}</p><p class="lede">{text.explain}</p></div><div class="metric-grid">{metrics.map(([number, name, bar]) => <div class="stat"><strong data-count={number.replace(',', '')}>{number}</strong><span>{name}</span><i style={`--bar:${bar}`}></i></div>)}</div></section>
  <section class="story-shell section-shell"><div class="story-visual reveal" data-story-visual><p class="story-note" data-story-note>{storySteps[0][0]}</p><div class="story-grid">{Array.from({ length: 70 }).map((_, i) => <i class="evidence-cell" style={`--r:${i % 7};--row:${Math.floor(i / 10)};--hi:${i % 5 === 0 ? 1 : .2}`}></i>)}</div><div class="story-center"><span>01</span><b data-story-center>{text.evidence}</b></div><div class="story-legend"><span>source</span><span>method</span><span>review</span></div></div><div class="story-copy"><div class="story-intro"><p class="eyebrow">{ui.source}</p><h2>{text.signal}</h2><p class="lede">{text.explain}</p></div>{storySteps.map(([heading, detail], i) => <div class="story-step" data-story-step={i + 1}><p class="stepno">0{i + 1}</p><h3>{heading}</h3><p>{detail}</p></div>)}</div></section>
  <section class="section-shell"><p class="eyebrow">{home.title}</p><div class="grid2">{home.blocks.slice(1).map((value) => { const item = block(value); return <article class="card reveal"><h3 set:html={inline(item.heading)}></h3>{item.list.length ? <ul>{item.list.map((line) => <li set:html={inline(line.slice(2))}></li>)}</ul> : item.body.map((line) => <p set:html={inline(line)}></p>)}</article>; })}</div></section>
  <section class="section-shell reveal"><p class="eyebrow">{ui.explorer}</p><div class="explorer"><div class="explorer-tabs" role="tablist">{explorer.map((item, i) => <button class="explorer-tab" type="button" role="tab" data-explorer={i} aria-selected={i === 0}>{item.n} · {item.t}</button>)}</div><div class="explorer-body" id="explorerBody"><div class="explorer-signal"><div class="explorer-mark">{explorer[0].n}</div><span>{explorer[0].t}</span></div><div class="explorer-detail"><h3>{explorer[0].t}</h3><p>{explorer[0].d}</p>{explorer[0].fields.map(([label, value]) => <div class="explorer-field"><span>{label}</span><p>{value}</p></div>)}</div></div></div></section>
  <section class="section-shell timeline reveal"><p class="eyebrow">{ui.timeline}</p><h2>2003 — 2026</h2><p class="lede">{lang === 'pt' ? 'Selecione uma etapa para ver a contribuição e o resultado.' : lang === 'it' ? 'Seleziona una fase per vedere il contributo e il risultato.' : lang === 'es' ? 'Selecciona una etapa para ver la contribución y el resultado.' : 'Select a stage to see the contribution and result.'}</p><div class="tl">{timeline.map(([year, title, result], i) => <button class="tl-row" type="button" data-timeline={JSON.stringify({year,title,result})} aria-pressed="false"><span>{year}</span><b>{title}</b><i style={`--fill:${18 + i * 10}%`}></i><small>{result}</small></button>)}</div><div class="tl-info" id="timelineResult" aria-live="polite"><strong>{timeline[0][1]}</strong><span>{timeline[0][2]}</span></div></section>
</article>

{pages.slice(1).map((page) => <article class="site-page page" data-page={page.id} id={page.id}><section class="section-shell page-intro reveal"><p class="eyebrow">{String(sectionIds.indexOf(page.id) + 1).padStart(2, '0')}</p><h1>{page.title}</h1></section>
  {page.id === 'research' && <section class="section-shell publication-panel reveal"><p class="eyebrow">{text.publications}</p><div class="filterbar"><button class="filterbtn" type="button" data-pub-filter="all" aria-pressed="true">{text.all}</button>{['Artigo revisado por pares', 'Policy brief', 'Working paper', 'Aplicação e dataset'].map((type) => <button class="filterbtn" type="button" data-pub-filter={type} aria-pressed="false">{type}</button>)}</div><div class="entries">{publicItems.map((item) => <article class="pub-entry card" data-pubcat={item.type}><p class="eyebrow">{item.status}</p><h3>{item.title}</h3><p>{item.summary}</p>{item.public_url && <a class="worklink" href={item.public_url.startsWith('/') ? `${base}${item.public_url.slice(1)}` : item.public_url} target="_blank" rel="noreferrer">{item.public_file?.endsWith('.pdf') ? 'PDF' : 'Open'}</a>}</article>)}</div></section>}
  {page.id === 'tools' && <section class="section-shell data-visual reveal"><p class="eyebrow">Signals by risk type</p><div class="chart">{[['risk flags', 72], ['eligible contracts', 92], ['human review', 48]].map(([name, value]) => <div class="bar-row"><span>{name}</span><div><i style={`--value:${value}%`}></i></div><b>{value}%</b></div>)}</div><button class="text-button" data-table-toggle>{ui.table}</button><table hidden data-data-table><caption>Signals by risk type</caption><tbody><tr><th>Risk flags</th><td>72%</td></tr><tr><th>Eligible contracts</th><td>92%</td></tr><tr><th>Human review</th><td>48%</td></tr></tbody></table></section>}
  <section class="section-shell"><div class="grid2">{page.blocks.map((value) => { const item = block(value); return <article class="card reveal"><h3 set:html={inline(item.heading)}></h3>{item.list.length ? <ul>{item.list.map((line) => <li set:html={inline(line.slice(2))}></li>)}</ul> : item.body.map((line) => <p set:html={inline(line)}></p>)}</article>; })}</div></section></article>)}

<script is:inline define:vars={{ explorer, storySteps }}>
  document.documentElement.classList.add('js');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const pages = [...document.querySelectorAll('.site-page')], links = [...document.querySelectorAll('[data-page-link]')];
  function activate(id){pages.forEach(p=>p.classList.toggle('on',p.dataset.page===id));links.forEach(l=>l.setAttribute('aria-current',l.dataset.pageLink===id?'page':'false'));document.querySelectorAll(`[data-page="${id}"] .reveal`).forEach(n=>n.classList.add('is-visible'));scrollTo({top:0,behavior:reduced?'auto':'smooth'});}
  document.addEventListener('click',e=>{const go=e.target.closest('[data-go],[data-page-link]');if(go){e.preventDefault();activate(go.dataset.go||go.dataset.pageLink)}const ex=e.target.closest('[data-explorer]');if(ex){const x=explorer[+ex.dataset.explorer];document.querySelectorAll('[data-explorer]').forEach(b=>b.setAttribute('aria-selected',String(b===ex)));document.getElementById('explorerBody').innerHTML=`<div class="explorer-signal"><div class="explorer-mark">${x.n}</div><span>${x.t}</span></div><div class="explorer-detail"><h3>${x.t}</h3><p>${x.d}</p>${x.fields.map(f=>`<div class="explorer-field"><span>${f[0]}</span><p>${f[1]}</p></div>`).join('')}</div>`}const f=e.target.closest('[data-pub-filter]');if(f){document.querySelectorAll('[data-pub-filter]').forEach(b=>b.setAttribute('aria-pressed',String(b===f)));document.querySelectorAll('.pub-entry').forEach(n=>n.hidden=f.dataset.pubFilter!=='all'&&n.dataset.pubcat!==f.dataset.pubFilter)}const t=e.target.closest('[data-timeline]');if(t){const data=JSON.parse(t.dataset.timeline);document.querySelectorAll('[data-timeline]').forEach(b=>b.setAttribute('aria-pressed',String(b===t)));document.getElementById('timelineResult').innerHTML=`<strong>${data.year} · ${data.title}</strong><span>${data.result}</span>`;document.getElementById('timelineModalDetail').textContent=data.result;document.getElementById('timelineModal').showModal()}if(e.target.closest('[data-close-dialog]'))document.getElementById('timelineModal').close();if(e.target.closest('[data-table-toggle]')){const t=document.querySelector('[data-data-table]');t.hidden=!t.hidden}});
  const progress=document.getElementById('scrollProgress');addEventListener('scroll',()=>{const m=document.documentElement.scrollHeight-innerHeight;progress.style.transform=`scaleX(${m?scrollY/m:0})`},{passive:true});
  function count(node){if(node.dataset.done)return;node.dataset.done='1';const target=Number(node.dataset.count);if(reduced){node.textContent=target.toLocaleString('en-US');return}const start=performance.now(),duration=1050;const frame=now=>{const p=Math.min(1,(now-start)/duration),value=Math.round(target*(1-Math.pow(1-p,3)));node.textContent=value.toLocaleString('en-US');if(p<1)requestAnimationFrame(frame)};requestAnimationFrame(frame)}
  const io=!reduced&&'IntersectionObserver'in window?new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('is-visible');e.target.querySelectorAll('[data-count]').forEach(count);io.unobserve(e.target)}}),{threshold:.12}):null;document.querySelectorAll('.reveal').forEach(n=>io?io.observe(n):n.classList.add('is-visible'));
  const visual=document.querySelector('[data-story-visual]');if(visual&&!reduced){const storyIo=new IntersectionObserver(es=>es.forEach(e=>{if(!e.isIntersecting)return;const n=Number(e.target.dataset.storyStep),step=storySteps[n-1];visual.dataset.step=String(n);visual.querySelector('.story-center span').textContent=`0${n}`;visual.querySelector('[data-story-center]').textContent=step[0];visual.querySelector('[data-story-note]').textContent=step[1]}),{threshold:.58,rootMargin:'-20% 0px -30% 0px'});document.querySelectorAll('[data-story-step]').forEach(n=>storyIo.observe(n))}
  if(!reduced)document.querySelectorAll('.card').forEach(card=>card.addEventListener('pointermove',e=>{const r=card.getBoundingClientRect();card.style.setProperty('--mx',`${e.clientX-r.left}px`);card.style.setProperty('--my',`${e.clientY-r.top}px`)}));
</script>
