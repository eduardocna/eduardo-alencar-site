---
import { copy, documents, sectionIds, type Locale, inline } from '../data/site';
interface Props { lang: Locale; }
const { lang } = Astro.props;
const document = documents[lang];
const ui = copy[lang];
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const hero = document.sections[0].blocks[0] ?? '';
const heroLines = hero.split('\n').filter(Boolean);
const metrics = [['13,042', 'RICs'], ['30,304', 'contracts'], ['32', 'tests']];
const explorer = [
  ['01', 'Integrity', 'Procurement microdata → audit priorities'],
  ['02', 'Causality', 'Counterfactual designs → reform learning'],
  ['03', 'Oversight', 'Text-as-data → substantive answers'],
  ['04', 'Delivery', 'Governance routines → decisions']
];
const timeline = [
  ['2003', 'Ipea', 'Public policy analysis'], ['2015', 'CGU', 'Integrity and public management'],
  ['2017', 'UC Irvine', 'PhD in Social Ecology'], ['2024', 'Chamber of Deputies', 'Senior Legislative Advisor']
];
---
<div class="scroll-progress" id="scrollProgress" aria-hidden="true"></div>
<dialog class="timeline-modal" id="timelineModal" aria-labelledby="timelineModalTitle">
  <div class="timeline-modal-inner"><button class="modal-close" type="button" data-close-dialog aria-label={ui.close}>×</button><p class="eyebrow">{ui.timeline}</p><h2 id="timelineModalTitle">Eduardo Alencar</h2><ul>{timeline.map(([year, place, detail]) => <li><strong>{year} · {place}</strong><br />{detail}</li>)}</ul></div>
</dialog>
<section id="home" class="hero section-shell">
  <div class="hero-txt">
    <p class="eyebrow">Eduardo Alencar · PhD · scholar-practitioner</p>
    <h1>{heroLines[1] ?? document.title}</h1>
    <p class="lede">{heroLines.slice(2, 5).join(' ')}</p>
    <div class="ctarow"><a class="cta" href="#research">{ui.read}</a><a class="cta ghost" href="#tools">{ui.tools}</a><a class="cta ghost" href="#cv">{ui.cv}</a></div>
  </div>
  <div class="portrait-stage reveal" aria-hidden="true"><span class="orbit-dot"></span><img class="portrait" src={`${base}images/eduardo-alencar.jpg`} alt="" width="212" height="212" /></div>
</section>
<section class="ledger section-shell reveal" aria-labelledby="metrics-title"><div><p class="eyebrow" id="metrics-title">{ui.metrics}</p><p class="lede">{ui.source}: public records, reproducible methods and explicit limits.</p></div><div class="metric-grid">{metrics.map(([n, label], index) => <div class="stat"><strong class="num" data-target={n.replace(',', '')}>{n}</strong><span>{label}</span><i style={`--bar:${[72, 92, 48][index]}%`}></i></div>)}</div></section>
<section class="story-shell section-shell reveal" aria-labelledby="story-title"><div class="story-visual"><div class="story-grid">{Array.from({ length: 25 }).map(() => <i></i>)}</div><div class="story-center" id="story-title">Evidence<br />→ action</div></div><div class="story-copy"><p class="eyebrow">{ui.source}</p><h2>Signal is not a verdict.</h2><p class="lede">Each visual claim remains tied to a source, a method and a human verification path.</p><button class="text-button" type="button" data-open-dialog>{ui.timeline}</button></div></section>
{document.sections.map((page, pageIndex) => {
  const id = sectionIds[pageIndex] ?? `section-${pageIndex}`;
  const blocks = pageIndex === 0 ? page.blocks.slice(1) : page.blocks;
  return <section id={id} class:list={["content-section", "section-shell", "reveal", { "home-detail": pageIndex === 0 }]} aria-labelledby={`${id}-title`}>
    <p class="eyebrow">{String(pageIndex + 1).padStart(2, '0')}</p><h2 id={`${id}-title`}>{page.title}</h2>
    <div class="content-grid">{blocks.map((block) => {
      const [heading, ...body] = block.split('\n').filter(Boolean);
      const isList = body.some((line) => line.startsWith('- '));
      return <article class="content-card"><h3 set:html={inline(heading.replace(/^## /, ''))}></h3>{isList ? <ul>{body.filter((line) => line.startsWith('- ')).map((line) => <li set:html={inline(line.slice(2))}></li>)}</ul> : body.map((line) => <p set:html={inline(line)}></p>)}</article>;
    })}</div>
    {id === 'tools' && <div class="explorer"><div class="explorer-tabs" role="tablist">{explorer.map(([mark, title], index) => <button class="explorer-tab" type="button" role="tab" data-explorer={index} aria-selected={index === 0}>{mark} · {title}</button>)}</div><div class="explorer-body" id="explorerBody">{explorer.slice(0, 1).map(([mark, title, detail]) => <><div class="explorer-signal"><div class="explorer-mark">{mark}</div><span>{title}</span></div><div class="explorer-detail"><h3>{ui.explorer}</h3><p>{detail}</p></div></>)}</div></div>}
  </section>;
})}
<section class="section-shell timeline reveal" aria-labelledby="timeline-title"><p class="eyebrow">{ui.timeline}</p><h2 id="timeline-title">2003 — 2026</h2><div class="tl">{timeline.map(([year, place, detail], index) => <button class="tl-row" type="button" data-open-dialog><span>{year}</span><b>{place}</b><i style={`--fill:${35 + index * 17}%`}></i><small>{detail}</small></button>)}</div></section>
<script is:inline>{`
  const rm=matchMedia('(prefers-reduced-motion: reduce)').matches;
  const progress=document.getElementById('scrollProgress');
  addEventListener('scroll',()=>{if(progress){const max=document.documentElement.scrollHeight-innerHeight;progress.style.transform='scaleX('+Math.min(1,scrollY/max)+')'}},{passive:true});
  const observer=!rm&&'IntersectionObserver' in window?new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('is-visible');observer.unobserve(e.target)}}),{threshold:.12}):null;
  document.querySelectorAll('.reveal').forEach(el=>observer?observer.observe(el):el.classList.add('is-visible'));
  const dialog=document.getElementById('timelineModal');document.querySelectorAll('[data-open-dialog]').forEach(b=>b.addEventListener('click',()=>dialog?.showModal()));document.querySelector('[data-close-dialog]')?.addEventListener('click',()=>dialog?.close());
  document.querySelectorAll('[data-explorer]').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll('[data-explorer]').forEach(x=>x.setAttribute('aria-selected',String(x===button)));const rows=${JSON.stringify(explorer)};const x=rows[Number(button.dataset.explorer)];document.getElementById('explorerBody').innerHTML='<div class="explorer-signal"><div class="explorer-mark">'+x[0]+'</div><span>'+x[1]+'</span></div><div class="explorer-detail"><h3>'+x[1]+'</h3><p>'+x[2]+'</p></div>'}));
`}</script>
