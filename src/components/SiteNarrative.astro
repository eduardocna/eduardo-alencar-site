---
// Home enxuta (27/10/2026): hero, o que eu faço (3 blocos com contexto), registro → evidência,
// livro, newsletter e publicações recentes. O restante vive nas páginas próprias.
import type { Locale } from '../data/site';
import Hero from './Hero.astro';
import ImpactTiles from './ImpactTiles.astro';
import EvidenceStory from './EvidenceStory.astro';
import BookTile from './BookTile.astro';
import NewsletterSignup from './NewsletterSignup.astro';
import RecentFeed from './RecentFeed.astro';
interface Props { lang: Locale; }
const { lang } = Astro.props;
---
<article id="home" class="home-v2">
  <Hero lang={lang} />
  <ImpactTiles lang={lang} />
  <EvidenceStory lang={lang} />
  <BookTile lang={lang} />
  <NewsletterSignup lang={lang} />
  <RecentFeed lang={lang} />
</article>
