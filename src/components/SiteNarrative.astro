---
import { copy, documents, sectionIds, type Locale, inline } from '../data/site';
import { publicItems } from '../data/catalog';
interface Props { lang: Locale; }
const { lang } = Astro.props;
const doc = documents[lang]; const ui = copy[lang];
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const pages = doc.sections.map((section, index) => ({ ...section, id: sectionIds[index] }));
const home = pages[0]; const hero = home.blocks[0]?.split('\n').filter(Boolean) ?? [];
const metrics = [['13,042', 'RICs', '72%'], ['30,304', lang === 'pt' ? 'contratações' : lang === 'it' ? 'contratti' : lang === 'es' ? 'contratos' : 'contracts', '92%'], ['32', lang === 'pt' ? 'testes' : lang === 'it' ? 'test' : lang === 'es' ? 'pruebas' : 'tests', '48%']];
const explorer = lang === 'pt' ? [
  { n:'01', t:'Integridade', d:'Microdados de compras transformados em prioridades auditáveis, sem confundir sinal de risco com prova.', fields:[['Escala','30.304 contratos federais'],['Entrega','32 testes e trilha de verificação humana']] },
  { n:'02', t:'Inferência causal', d:'Desenhos contrafactuais para separar mudança institucional de coincidência temporal.', fields:[['Métodos','Controle sintético, DiD e RDD'],['Uso','Reformas, governança e resultados de desenvolvimento']] },
  { n:'03', t:'Fiscalização', d:'Texto como dado para medir se uma resposta respondeu à pergunta, não apenas se chegou no prazo.', fields:[['Base','13.042 pares RIC-resposta'],['Saída','Completude, evidência, atraso e evasão substantiva']] },
  { n:'04', t:'Sistemas de governança', d:'Instrumentação que liga objetivos públicos, decisões e rotinas de acompanhamento.', fields:[['Stack','Python, Airtable, Power BI e APIs'],['Princípio','Transparência metodológica antes de automação']] }
] : lang === 'es' ? [
  { n:'01', t:'Integridad', d:'Microdatos de compras convertidos en prioridades auditables, sin confundir una señal de riesgo con prueba.', fields:[['Escala','30.304 contratos federales'],['Entrega','32 pruebas y verificación humana']] },
  { n:'02', t:'Inferencia causal', d:'Diseños contrafactuales para separar el cambio institucional de la coincidencia temporal.', fields:[['Métodos','Control sintético, DiD y RDD'],['Uso','Reformas, gobernanza y desarrollo']] },
  { n:'03', t:'Control', d:'Texto como datos para medir si una respuesta contestó la pregunta, no solo si llegó a tiempo.', fields:[['Base','13.042 pares solicitud-respuesta'],['Salida','Completitud, evidencia, retraso y evasión']] },
  { n:'04', t:'Sistemas de gobernanza', d:'Instrumentación que conecta objetivos públicos, decisiones y seguimiento.', fields:[['Stack','Python, Airtable, Power BI y APIs'],['Principio','Transparencia metodológica antes de automatizar']] }
] : lang === 'it' ? [
  { n:'01', t:'Integrità', d:'Microdati sugli appalti trasformati in priorità di audit, senza confondere un segnale di rischio con una prova.', fields:[['Scala','30.304 contratti federali'],['Consegna','32 test e verifica umana']] },
  { n:'02', t:'Inferenza causale', d:'Disegni controfattuali per distinguere il cambiamento istituzionale dalla coincidenza temporale.', fields:[['Metodi','Controllo sintetico, DiD e RDD'],['Uso','Riforme, governance e sviluppo']] },
  { n:'03', t:'Controllo', d:'Text-as-data per misurare se una risposta affronta la domanda, non solo se arriva in tempo.', fields:[['Base','13.042 coppie richiesta-risposta'],['Output','Completezza, evidenza, ritardo ed evasione']] },
  { n:'04', t:'Sistemi di governance', d:'Strumentazione che collega obiettivi pubblici, decisioni e routine di monitoraggio.', fields:[['Stack','Python, Airtable, Power BI e API'],['Principio','Trasparenza metodologica prima dell’automazione']] }
] : [
  { n:'01', t:'Integrity', d:'Procurement microdata turned into auditable priorities without confusing a risk signal with proof.', fields:[['Scale','30,304 federal contracts'],['Delivery','32 tests and a human verification trail']] },
  { n:'02', t:'Causal inference', d:'Counterfactual designs that separate institutional change from temporal coincidence.', fields:[['Methods','Synthetic Control, DiD and RDD'],['Use','Reforms, governance and development outcomes']] },
  { n:'03', t:'Oversight', d:'Text-as-data that measures whether a response answered the question, not only whether it arrived on time.', fields:[['Base','13,042 request-response pairs'],['Output','Completeness, evidence, delay and substantive evasion']] },
  { n:'04', t:'Governance systems', d:'Instrumentation that connects public objectives, decisions and monitoring routines.', fields:[['Stack','Python, Airtable, Power BI and APIs'],['Principle','Method transparency before automation']] }
];
const storySteps = lang === 'pt' ? [['Fonte','O registro preserva denominadores, data de extração e procedência.'],['Método','A regra analítica é explícita e reproduzível.'],['Revisão','O algoritmo prioriza, uma pessoa verifica.'],['Decisão','Evidência chega à decisão com seus limites visíveis.']] : lang === 'it' ? [['Fonte','Il record conserva denominatori, data di estrazione e provenienza.'],['Metodo','La regola analitica è esplicita e riproducibile.'],['Revisione','L’algoritmo dà priorità, una persona verifica.'],['Decisione','L’evidenza arriva alla decisione con i propri limiti visibili.']] : lang === 'es' ? [['Fuente','El registro conserva denominadores, fecha de extracción y procedencia.'],['Método','La regla analítica es explícita y reproducible.'],['Revisión','El algoritmo prioriza, una persona verifica.'],['Decisión','La evidencia llega a la decisión con sus límites visibles.']] : [['Source','The record keeps denominators, extraction date and provenance.'],['Method','The analytical rule is explicit and reproducible.'],['Review','The algorithm prioritizes, a person verifies.'],['Decision','Evidence reaches the decision with its limits visible.']];
const timeline = lang === 'pt' ? [['2003','Ipea','Análise de política industrial e inteligência econômica aplicada ao setor público.'],['2013','SAE','Produção de evidências sobre classe média, emprego e capacidade estatal.'],['2015','CGU','Integridade, controle e gestão pública federal.'],['2017','UC Irvine','Início do doutorado em Social Ecology e pesquisa de métodos causais.'],['2021','Doutorado','Tese sobre detecção de fraude em compras públicas brasileiras.'],['2024','Anatel','Direção de assessoria técnica e secretaria executiva do Ceadi.'],['2024','Câmara dos Deputados','Consultoria legislativa sênior: fiscalização, dados e integridade.'],['2026','Fraud Research Group','Colaboração internacional em risco de fraude e compras públicas.']] : lang === 'it' ? [['2003','Ipea','Analisi di politica industriale e intelligenza economica per il settore pubblico.'],['2013','SAE','Evidenza su classe media, lavoro e capacità statale.'],['2015','CGU','Integrità, controllo e gestione pubblica federale.'],['2017','UC Irvine','Inizio del dottorato in Social Ecology e ricerca sui metodi causali.'],['2021','Dottorato','Tesi sul rilevamento delle frodi negli appalti pubblici brasiliani.'],['2024','Anatel','Direzione dell’assistenza tecnica e segreteria esecutiva del Ceadi.'],['2024','Camera dei Deputati','Consulenza legislativa senior: controllo, dati e integrità.'],['2026','Fraud Research Group','Collaborazione internazionale su rischio di frode e appalti pubblici.']] : lang === 'es' ? [['2003','Ipea','Análisis de política industrial e inteligencia económica para el sector público.'],['2013','SAE','Evidencia sobre clase media, empleo y capacidad estatal.'],['2015','CGU','Integridad, control y gestión pública federal.'],['2017','UC Irvine','Inicio del doctorado en Social Ecology y métodos causales.'],['2021','Doctorado','Tesis sobre detección de fraude en compras públicas brasileñas.'],['2024','Anatel','Dirección de asesoría técnica y secretaría ejecutiva del Ceadi.'],['2024','Cámara de Diputados','Asesoría legislativa sénior: control, datos e integridad.'],['2026','Fraud Research Group','Colaboración internacional sobre fraude y compras públicas.']] : [['2003','Ipea','Industrial policy analysis and public-sector economic intelligence.'],['2013','SAE','Evidence on the middle class, work and state capacity.'],['2015','CGU','Public integrity, oversight and federal management.'],['2017','UC Irvine','PhD in Social Ecology and causal-methods research begins.'],['2021','PhD','Dissertation on detecting fraud in Brazilian public procurement.'],['2024','Anatel','Technical advisory leadership and Ceadi executive secretariat.'],['2024','Chamber of Deputies','Senior legislative advisory: oversight, data and integrity.'],['2026','Fraud Research Group','International collaboration on fraud risk and public procurement.']];
const text = { evidence: lang === 'pt' ? 'Evidência → decisão' : lang === 'es' ? 'Evidencia → decisión' : lang === 'it' ? 'Evidenza → decisione' : 'Evidence → action', signal: lang === 'pt' ? 'Sinal não é veredito.' : lang === 'es' ? 'Una señal no es un veredicto.' : lang === 'it' ? 'Un segnale non è un verdetto.' : 'Signal is not a verdict.', explain: lang === 'pt' ? 'Cada afirmação visual permanece ligada a uma fonte, método e caminho de verificação humana.' : lang === 'es' ? 'Cada afirmación visual permanece vinculada a una fuente, método y vía de verificación humana.' : lang === 'it' ? 'Ogni affermazione visiva resta collegata a una fonte, un metodo e un percorso di verifica umana.' : 'Each visual claim remains tied to a source, a method and a human verification path.', all: lang === 'it' ? 'Tutti' : lang === 'en' ? 'All' : 'Todos', publications: lang === 'pt' ? 'Publicações' : lang === 'es' ? 'Publicaciones' : lang === 'it' ? 'Pubblicazioni' : 'Publications' };
const reference = lang === 'pt' ? { storyEyebrow:'Da fiscalização à evidência', storyTitle:'Como uma pergunta parlamentar se transforma em evidência auditável', storyLede:'Um mapa vivo para converter registros públicos dispersos em apoio à decisão estruturado e revisável.', note:'Fluxo conceitual: as cores indicam dimensões analíticas, não proporções observadas.', legend:['Completude','Objetividade','Tempestividade','Evidência','Sinal de risco'], explorerEyebrow:'Portfólio interativo', explorerTitle:'Explore o trabalho pelo problema público', explorerLede:'Escolha um eixo para ver a pergunta, o método e a entrega concreta por trás do trabalho.', open:'Abrir trabalhos relacionados', timelineTitle:'Vinte anos, cinco instituições', timelineLede:'Funções exercidas por ano. As sobreposições são reais: o doutorado na UC Irvine coincidiu com o retorno ao serviço público brasileiro em 2021–2022.', hint:'Selecione uma barra para conhecer este capítulo da trajetória.' } : lang === 'es' ? { storyEyebrow:'Del control a la evidencia', storyTitle:'Cómo una pregunta parlamentaria se convierte en evidencia auditable', storyLede:'Un mapa vivo para convertir registros públicos dispersos en apoyo a decisiones estructurado y revisable.', note:'Flujo conceptual: los colores indican dimensiones analíticas, no proporciones observadas.', legend:['Completitud','Objetividad','Oportunidad','Evidencia','Señal de riesgo'], explorerEyebrow:'Portafolio interactivo', explorerTitle:'Explora el trabajo por problema público', explorerLede:'Elige un eje para ver la pregunta, el método y el resultado concreto.', open:'Abrir trabajo relacionado', timelineTitle:'Veinte años, cinco instituciones', timelineLede:'Funciones ejercidas por año. Las superposiciones son reales.', hint:'Selecciona una barra para conocer este capítulo de la trayectoria.' } : lang === 'it' ? { storyEyebrow:'Dal controllo all’evidenza', storyTitle:'Come una domanda parlamentare diventa evidenza verificabile', storyLede:'Una mappa viva per trasformare registri pubblici dispersi in supporto decisionale strutturato e rivedibile.', note:'Flusso concettuale: i colori indicano dimensioni analitiche, non proporzioni osservate.', legend:['Completezza','Obiettività','Tempestività','Evidenza','Segnale di rischio'], explorerEyebrow:'Portfolio interattivo', explorerTitle:'Esplora il lavoro per problema pubblico', explorerLede:'Scegli un asse per vedere domanda, metodo e output concreto.', open:'Apri lavoro correlato', timelineTitle:'Venti anni, cinque istituzioni', timelineLede:'Ruoli ricoperti per anno. Le sovrapposizioni sono reali.', hint:'Seleziona una barra per esaminare questo capitolo del percorso.' } : { storyEyebrow:'From oversight to evidence', storyTitle:'How a parliamentary question becomes auditable evidence', storyLede:'A living map that turns dispersed public records into structured, reviewable decision support.', note:'Conceptual flow — colours indicate analytical dimensions, not observed proportions.', legend:['Completeness','Objectivity','Timeliness','Evidence','Risk signal'], explorerEyebrow:'Interactive portfolio', explorerTitle:'Explore the work by public problem', explorerLede:'Choose an axis to see the question, method and concrete output behind the work.', open:'Open related work', timelineTitle:'Twenty years, five institutions', timelineLede:'Roles held, by year. Overlaps are real: the doctorate at UC Irvine ran alongside the return to Brazilian public service in 2021–2022.', hint:'Select a bar to inspect this chapter of the trajectory.' };
const explorerWork = [
  { tab: lang==='pt'?'Integridade':lang==='es'?'Integridad':lang==='it'?'Integrità':'Integrity', mark:'30,304', label:lang==='pt'?'contratações federais analisadas':'federal contracts screened', title:lang==='pt'?'Tornar visível o risco em compras':'Make procurement risk visible', problem:lang==='pt'?'Como priorizar grandes carteiras de contratação sem tratar um sinal de risco como prova de irregularidade?':'How can oversight teams triage large contracting portfolios without treating a risk flag as proof of wrongdoing?', method:lang==='pt'?'Análise de classes latentes, indicadores reproduzíveis e controles explícitos de incerteza.':'Latent class analysis, reproducible indicators and explicit uncertainty controls.', output:lang==='pt'?'Radar Aberto e um modelo de analítica de integridade cobrindo 30.304 contratos.':'Radar Aberto and an integrity analytics framework covering 30,304 contracts.', page:'tools' },
  { tab:lang==='pt'?'Fiscalização':lang==='es'?'Control':lang==='it'?'Controllo':'Oversight', mark:'13,042', label:lang==='pt'?'pares de requerimento e resposta analisados':'request–reply pairs analysed', title:lang==='pt'?'Medir a qualidade das respostas governamentais':'Measure the quality of government replies', problem:lang==='pt'?'Respostas formais realmente atendem às perguntas parlamentares?':'Do formal replies actually answer legislators’ questions?', method:lang==='pt'?'Text-as-data, cinco dimensões de auditoria e validação humana.':'Text-as-data, five audit dimensions and human validation.', output:lang==='pt'?'Sistema de auditoria com IA construído a partir de 13.042 pares.':'An AI audit system built from 13,042 public request–reply pairs.',page:'tools' },
  { tab:lang==='pt'?'Governança':lang==='es'?'Gobernanza':lang==='it'?'Governance':'Governance', mark:'20+', label:lang==='pt'?'anos no serviço público':'years in public service', title:lang==='pt'?'Converter estratégia em entrega responsável':'Turn strategy into accountable delivery', problem:lang==='pt'?'Como conectar mandatos, decisões, indicadores e implementação?':'How do institutions connect mandates, decisions, indicators and implementation?', method:lang==='pt'?'Desenho de governança, instrumentação e monitoramento.':'Governance design, instrumentation and monitoring.', output:lang==='pt'?'Sistemas aplicados em cinco instituições federais.':'Applied systems across five federal institutions.',page:'cv' },
  { tab:lang==='pt'?'Avaliação':lang==='es'?'Evaluación':lang==='it'?'Valutazione':'Evaluation', mark:'SCM', label:'Synthetic Control Method', title:lang==='pt'?'Testar se uma reforma alterou resultados':'Test whether a reform changed outcomes', problem:lang==='pt'?'O que plausivelmente teria ocorrido na ausência de uma intervenção?':'What would plausibly have happened without an intervention?', method:lang==='pt'?'Controle sintético, diferenças em diferenças e testes de robustez.':'Synthetic control, difference-in-differences and robustness checks.', output:lang==='pt'?'Pesquisa sobre enforcement, reforma institucional e desempenho público.':'Research on enforcement, institutional reform and public-sector performance.',page:'research' }
];
const timelineBars = [['Ipea',2003,2005],['Anatel',2005,2013],['Presidency · SAE',2013,2015],['CGU',2015,2016],['Planning · Camex · CPRM',2016,2017],['UC Irvine (MA, PhD)',2017,2022],['Inep',2021,2022],['Ministry of Infrastructure',2022,2023],['Anatel',2023,2024],['Chamber of Deputies',2024,2026]] as const;
const block = (value: string) => { const [heading, ...body] = value.split('\n').filter(Boolean); return { heading: heading.replace(/^## /, ''), body, list: body.filter((line) => line.startsWith('- ')) }; };
---
<div class="scroll-progress" id="scrollProgress" aria-hidden="true"></div>
<dialog class="timeline-modal" id="timelineModal"><div class="timeline-modal-inner"><button class="modal-close" type="button" data-close-dialog aria-label={ui.close}>×</button><p class="eyebrow">{ui.timeline}</p><h2>Eduardo Alencar</h2><p id="timelineModalDetail"></p></div></dialog>
<style is:global>
  .card{position:relative;overflow:hidden;transition:transform .35s cubic-bezier(.2,.8,.2,1),border-color .35s,box-shadow .35s}.card::before{content:"";position:absolute;inset:0;pointer-events:none;opacity:0;background:radial-gradient(360px circle at var(--mx,50%) var(--my,20%),color-mix(in srgb,var(--accent) 14%,transparent),transparent 48%);transition:opacity .3s}.card:hover{transform:translateY(-5px);border-color:var(--accent);box-shadow:0 20px 44px -28px #000}.card:hover::before{opacity:1}.stat strong{font-variant-numeric:tabular-nums}.story-visual{position:sticky;top:104px;min-height:620px}.story-grid{grid-template-columns:repeat(10,1fr);align-content:center}.story-note{position:absolute;top:18px;left:20px;right:20px;z-index:3;font:10px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}.story-center{z-index:2;box-shadow:0 16px 42px -24px #000;padding:18px}.story-center span{display:block;font:10px var(--mono);letter-spacing:.12em;margin-bottom:8px}.story-center b{font-weight:400}.story-legend{position:absolute;bottom:18px;left:20px;right:20px;z-index:2;display:flex;justify-content:center;gap:14px;font:10px var(--mono);letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}.story-step{min-height:52vh;display:flex;flex-direction:column;justify-content:center}.stepno{font:11px var(--mono);color:var(--accent);letter-spacing:.12em}.story-step h3{font:400 30px var(--serif);margin:0}.explorer-detail{display:grid;grid-template-columns:1fr 1fr;gap:20px}.explorer-detail h3,.explorer-detail>p{grid-column:1/-1}.explorer-field{border-top:1px solid var(--rule);padding-top:12px}.explorer-field span{font:10px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}.explorer-field p{margin:4px 0 0}.tl-row{grid-template-columns:76px minmax(150px,.8fr) 1.5fr;transition:background .2s,padding .2s}.tl-row:hover,.tl-row[aria-pressed="true"]{background:var(--surface2);padding-left:12px}.tl-row small{grid-column:2/-1;font:13px/1.45 var(--sans);letter-spacing:0;text-transform:none}.tl-info{margin-top:16px;padding:16px;border:1px solid var(--rule);border-radius:8px;background:var(--surface2);display:grid;gap:5px}.tl-info strong{font:400 22px var(--serif)}.tl-info span{color:var(--muted)}@media(max-width:900px){.story-visual{position:relative;top:0;min-height:400px}.story-step{min-height:auto;padding:44px 0}.explorer-detail{grid-template-columns:1fr}.tl-row{grid-template-columns:58px 1fr}.tl-row i,.tl-row small{grid-column:2}.card:hover{transform:none}}@media(prefers-reduced-motion:reduce){.card,.card::before,.tl-row{transition:none}.card:hover{transform:none}}
</style>
<style is:global>
  :root,html[data-theme="light"]{--d0:#4285d4;--d1:#f57745;--d2:#3ab886;--d3:#226964;--d4:#ae662b;--bg:#f6f7f4;--surface:#fff;--surface2:#eff1ee;--ink:#182125;--ink-2:#4e5959;--muted:#747e7d;--rule:#dbe0dc;--accent:#165d59;--accent-ink:#0f4945;--accent-soft:#e6f0ee;--shadow:0 14px 30px -22px rgba(22,34,33,.45);--chart-surface:#fff}.protobar{position:sticky;top:0;z-index:30;min-height:122px;background:color-mix(in srgb,var(--bg) 94%,transparent);box-shadow:0 7px 17px -18px #000;border-bottom:1px solid var(--rule)}.brand{display:flex;flex-direction:column;font:400 28px/1.1 var(--serif);text-decoration:none;color:var(--ink)}.brand span{margin-top:13px;font:11px var(--mono);letter-spacing:.15em;text-transform:uppercase;color:var(--muted)}.protobar nav a{font:16px var(--sans);letter-spacing:0;text-transform:none;padding:13px 15px;border-radius:7px}.protobar nav a[aria-current="page"]{background:var(--accent-soft);color:var(--accent-ink);font-weight:650}.toolbar{align-items:center}.langtoggle{border-color:var(--rule);box-shadow:var(--shadow)}.langtoggle a{padding:16px 14px;font-size:12px}.themebtn{min-width:190px;padding:14px 18px;font-size:12px}.section-shell{width:min(100% - 44px,1360px);padding:72px 0}.hero{min-height:540px;grid-template-columns:minmax(0,1.1fr) .9fr;gap:52px}.hero h1{font-size:clamp(50px,6vw,86px)}.hero-txt .eyebrow{display:none}.ledger{grid-template-columns:repeat(3,1fr);gap:1px;background:var(--rule);border:1px solid var(--rule);border-radius:9px;overflow:hidden;padding:0}.ledger>div:first-child{display:none}.metric-grid{display:contents}.stat{background:var(--surface);padding:22px}.stat strong{font-size:40px}.stat i{display:none}.stat span::after{content:' · public records';display:block;margin-top:9px;font:10px var(--mono);letter-spacing:.05em;text-transform:uppercase;color:var(--muted)}.story-shell{grid-template-columns:minmax(0,1.25fr) minmax(300px,.75fr);gap:52px;align-items:start}.story-visual{min-height:620px;background:var(--surface);box-shadow:var(--shadow)}.story-grid{inset:54px;grid-template-columns:repeat(10,1fr);gap:8px}.evidence-cell{aspect-ratio:1;border-radius:3px;background:var(--rule);opacity:.56;transform:scale(.82);transition:transform .75s cubic-bezier(.2,.8,.2,1),background .55s,opacity .55s,border-radius .55s}.story-visual[data-step="1"] .evidence-cell{transform:scale(.68) rotate(calc(var(--r)*1deg));opacity:.42}.story-visual[data-step="2"] .evidence-cell{background:var(--c);transform:translateY(calc(var(--r)*2px)) scale(.88);opacity:.72}.story-visual[data-step="3"] .evidence-cell{background:var(--c);transform:translate(calc(var(--dx)*1px),calc(var(--dy)*1px)) scale(1);border-radius:50%;opacity:.86}.story-visual[data-step="4"] .evidence-cell{background:var(--c);transform:scale(calc(.72 + var(--hi)*.32));border-radius:calc(3px + var(--hi)*12px);opacity:calc(.34 + var(--hi)*.62)}.story-center{position:absolute;background:var(--surface);border:1px solid var(--rule);color:var(--ink)}.story-legend i{width:8px;height:8px;border-radius:2px;background:var(--c)}.story-copy{padding-bottom:15vh}.story-intro{min-height:42vh;padding-top:12px}.story-step{min-height:62vh}.explorer-panel{background:var(--surface);border:1px solid var(--rule);border-radius:18px;padding:42px;box-shadow:var(--shadow)}.explorer-panel>h2{font:400 clamp(38px,5vw,62px)/1 var(--serif);margin:0}.explorer{margin-top:32px;border-radius:0;box-shadow:none}.explorer-body{min-height:490px;grid-template-columns:.8fr 1.2fr}.explorer-signal{padding:60px;background:radial-gradient(circle at 20% 15%,var(--accent-soft),transparent 58%)}.explorer-mark{font-size:clamp(80px,10vw,138px)}.explorer-mark small{display:block;margin-top:14px;font:11px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}.explorer-signal h3{font:400 42px/1.08 var(--serif);margin:28px 0 0}.explorer-detail{padding:60px;grid-template-columns:1fr 1fr;align-content:start}.explorer-detail .explorer-field:nth-child(3){grid-column:1/-1}.explorer-detail .cta{align-self:end;justify-self:end;margin-top:40px}.figure{background:var(--surface);border:1px solid var(--rule);border-radius:14px;padding:38px;box-shadow:var(--shadow)}.figure>h2{font:400 42px/1.1 var(--serif);margin:0}.tl{gap:7px;margin-top:28px}.tl-row{display:grid;grid-template-columns:210px 1fr;gap:14px;align-items:center;padding:0;border:0}.tl-name{font-size:14px;color:var(--ink-2);text-decoration:underline;text-decoration-color:var(--accent-soft);text-underline-offset:6px}.tl-track{position:relative;height:28px}.tl-fill{position:absolute;top:0;left:var(--left);width:var(--width);height:100%;border:0;border-radius:4px;background:var(--d0);opacity:.78;transform:scaleX(0);transform-origin:left;transition:transform .9s cubic-bezier(.2,.8,.25,1)}.is-visible .tl-fill{transform:scaleX(1)}.tl-fill.now{background:var(--accent);opacity:1}.tl-axis{display:flex;justify-content:space-between;margin-top:12px;padding-top:8px;border-top:1px solid var(--rule);font:11px var(--mono);color:var(--muted)}.tl-info{margin-top:18px;padding:16px;border:1px solid var(--rule);border-radius:8px;background:var(--surface2);display:block}.card,.chart{box-shadow:var(--shadow);background:var(--surface)}@media(max-width:980px){.protobar{min-height:auto;flex-wrap:wrap;padding-top:16px;padding-bottom:16px}.protobar nav{order:3;width:100%;overflow:auto}.brand{font-size:24px}.story-shell{grid-template-columns:1fr}.story-visual{position:relative;top:0}.explorer-detail{padding:30px}.explorer-signal{padding:30px}}@media(max-width:620px){.section-shell{width:min(100% - 28px,1360px)}.toolbar{margin-left:0}.themebtn{display:none}.ledger{grid-template-columns:1fr}.explorer-panel{padding:24px}.explorer-body{grid-template-columns:1fr}.explorer-signal{border-right:0;border-bottom:1px solid var(--rule)}.explorer-detail{grid-template-columns:1fr}.tl-row{grid-template-columns:1fr}.tl-track{height:20px}.story-grid{inset:55px 24px 70px;gap:5px}}
</style>

<article class="site-page page on" data-page="home" id="home">
  <section class="hero section-shell"><div class="hero-txt reveal"><p class="eyebrow">{hero[0] ?? 'Eduardo Alencar · PhD · scholar-practitioner'}</p><h1 set:html={inline(hero[1] ?? doc.title)}></h1><p class="lede">{hero.slice(2).join(' ')}</p><div class="ctarow"><button class="cta" data-go="research">{ui.read}</button><button class="cta ghost" data-go="tools">{ui.tools}</button><button class="cta ghost" data-go="cv">{ui.cv}</button></div></div><div class="portrait-stage reveal"><span class="orbit-dot"></span><img class="portrait" src={`${base}images/eduardo-alencar.jpg`} alt="Eduardo Alencar" width="212" height="212" /></div></section>
  <section class="ledger section-shell reveal"><div><p class="eyebrow">{ui.metrics}</p><p class="lede">{text.explain}</p></div><div class="metric-grid">{metrics.map(([number, name, bar]) => <div class="stat"><strong data-count={number.replace(',', '')}>{number}</strong><span>{name}</span><i style={`--bar:${bar}`}></i></div>)}</div></section>
  <section class="story-shell section-shell"><div class="story-visual reveal" data-story-visual data-step="1"><small class="story-note" data-story-note>{reference.note}</small><div class="story-grid" aria-hidden="true">{Array.from({ length: 70 }).map((_, i) => <i class="evidence-cell" style={`--c:var(--d${i % 5});--r:${Math.floor(i / 10)};--dx:${((i * 17) % 9) - 4};--dy:${((i * 11) % 7) - 3};--hi:${i % 13 === 0 ? 1 : 0}`}></i>)}</div><div class="story-center"><span>01</span><b data-story-center>{lang==='pt'?'13.042 pares públicos':lang==='es'?'13.042 pares públicos':lang==='it'?'13.042 coppie pubbliche':'13,042 public pairs'}</b></div><div class="story-legend">{reference.legend.map((label, i) => <span><i style={`--c:var(--d${i})`}></i>{label}</span>)}</div></div><div class="story-copy"><p class="eyebrow">{reference.storyEyebrow}</p><h2>{reference.storyTitle}</h2><p class="lede">{reference.storyLede}</p>{storySteps.map(([heading, detail], i) => <article class="story-step" data-story-step={i + 1}><span class="stepno">0{i + 1}</span><h3>{heading}</h3><p>{detail}</p></article>)}</div></section>
  <section class="section-shell"><p class="eyebrow">{home.title}</p><div class="grid2">{home.blocks.slice(1).map((value) => { const item = block(value); return <article class="card reveal"><h3 set:html={inline(item.heading)}></h3>{item.list.length ? <ul>{item.list.map((line) => <li set:html={inline(line.slice(2))}></li>)}</ul> : item.body.map((line) => <p set:html={inline(line)}></p>)}</article>; })}</div></section>
  <section class="explorer-panel section-shell reveal"><p class="eyebrow">{reference.explorerEyebrow}</p><h2>{reference.explorerTitle}</h2><p class="lede">{reference.explorerLede}</p><div class="explorer"><div class="explorer-tabs" role="tablist">{explorerWork.map((item, i) => <button class="explorer-tab" type="button" role="tab" data-explorer={i} aria-selected={i === 0}>{item.tab}</button>)}</div><div class="explorer-body" id="explorerBody"><div class="explorer-signal"><div class="explorer-mark">{explorerWork[0].mark}<small>{explorerWork[0].label}</small></div><span>{explorerWork[0].tab}</span><h3>{explorerWork[0].title}</h3></div><div class="explorer-detail"><div class="explorer-field"><span>{lang==='pt'?'Problema':'Problem'}</span><p>{explorerWork[0].problem}</p></div><div class="explorer-field"><span>{lang==='pt'?'Método':'Method'}</span><p>{explorerWork[0].method}</p></div><div class="explorer-field"><span>{lang==='pt'?'Entrega':'Output'}</span><p>{explorerWork[0].output}</p></div><button class="cta ghost" data-go={explorerWork[0].page}>{reference.open}</button></div></div></div></section>
  <section class="section-shell timeline reveal"><div class="figure"><h2>{reference.timelineTitle}</h2><p class="lede">{reference.timelineLede}</p><div class="tl">{timelineBars.map(([name, start, end], i) => <div class="tl-row"><span class="tl-name">{name}</span><div class="tl-track"><button class:list={['tl-fill', { now: i === timelineBars.length - 1 }]} type="button" data-timeline={JSON.stringify({year:`${start}–${end}`,title:name,result:timeline[i]?.[2] ?? name})} aria-pressed="false" style={`--left:${((start-2003)/24*100).toFixed(2)}%;--width:${((end-start)/24*100).toFixed(2)}%`}></button></div></div>)}</div><div class="tl-axis"><span>2003</span><span>2009</span><span>2015</span><span>2021</span><span>2026</span></div><div class="tl-info" id="timelineResult" aria-live="polite">{reference.hint}</div></div></section>
</article>

{pages.slice(1).map((page) => <article class="site-page page" data-page={page.id} id={page.id}><section class="section-shell page-intro reveal"><p class="eyebrow">{String(sectionIds.indexOf(page.id) + 1).padStart(2, '0')}</p><h1>{page.title}</h1>{page.intro.map((line) => <p class="lede" set:html={inline(line)}></p>)}</section>
  {page.id === 'research' && <section class="section-shell publication-panel reveal"><p class="eyebrow">{text.publications}</p><div class="filterbar"><button class="filterbtn" type="button" data-pub-filter="all" aria-pressed="true">{text.all}</button>{['Artigo revisado por pares', 'Policy brief', 'Working paper', 'Aplicação e dataset'].map((type) => <button class="filterbtn" type="button" data-pub-filter={type} aria-pressed="false">{type}</button>)}</div><div class="entries">{publicItems.map((item) => <article class="pub-entry card" data-pubcat={item.type}><p class="eyebrow">{item.status}</p><h3>{item.title}</h3><p>{item.summary}</p>{item.public_url && <a class="worklink" href={item.public_url.startsWith('/') ? `${base}${item.public_url.slice(1)}` : item.public_url} target="_blank" rel="noreferrer">{item.public_file?.endsWith('.pdf') ? 'PDF' : 'Open'}</a>}</article>)}</div></section>}
  {page.id === 'tools' && <section class="section-shell data-visual reveal"><p class="eyebrow">Signals by risk type</p><div class="chart">{[['risk flags', 72], ['eligible contracts', 92], ['human review', 48]].map(([name, value]) => <div class="bar-row"><span>{name}</span><div><i style={`--value:${value}%`}></i></div><b>{value}%</b></div>)}</div><button class="text-button" data-table-toggle>{ui.table}</button><table hidden data-data-table><caption>Signals by risk type</caption><tbody><tr><th>Risk flags</th><td>72%</td></tr><tr><th>Eligible contracts</th><td>92%</td></tr><tr><th>Human review</th><td>48%</td></tr></tbody></table></section>}
  <section class="section-shell"><div class="grid2">{page.blocks.map((value) => { const item = block(value); return <article class="card reveal"><h3 set:html={inline(item.heading)}></h3>{item.list.length ? <ul>{item.list.map((line) => <li set:html={inline(line.slice(2))}></li>)}</ul> : item.body.map((line) => <p set:html={inline(line)}></p>)}</article>; })}</div></section></article>)}

<script is:inline define:vars={{ explorerWork, storySteps }}>
  document.documentElement.classList.add('js');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const pages = [...document.querySelectorAll('.site-page')], links = [...document.querySelectorAll('[data-page-link]')];
  function activate(id){pages.forEach(p=>p.classList.toggle('on',p.dataset.page===id));links.forEach(l=>l.setAttribute('aria-current',l.dataset.pageLink===id?'page':'false'));document.querySelectorAll(`[data-page="${id}"] .reveal`).forEach(n=>n.classList.add('is-visible'));scrollTo({top:0,behavior:reduced?'auto':'smooth'});}
  document.addEventListener('click',e=>{const go=e.target.closest('[data-go],[data-page-link]');if(go){e.preventDefault();activate(go.dataset.go||go.dataset.pageLink)}const ex=e.target.closest('[data-explorer]');if(ex){const x=explorerWork[+ex.dataset.explorer];document.querySelectorAll('[data-explorer]').forEach(b=>b.setAttribute('aria-selected',String(b===ex)));document.getElementById('explorerBody').innerHTML=`<div class="explorer-signal"><div class="explorer-mark">${x.mark}<small>${x.label}</small></div><span>${x.tab}</span><h3>${x.title}</h3></div><div class="explorer-detail"><div class="explorer-field"><span>Problem</span><p>${x.problem}</p></div><div class="explorer-field"><span>Method</span><p>${x.method}</p></div><div class="explorer-field"><span>Output</span><p>${x.output}</p></div><button class="cta ghost" data-go="${x.page}">Open related work</button></div>`}const f=e.target.closest('[data-pub-filter]');if(f){document.querySelectorAll('[data-pub-filter]').forEach(b=>b.setAttribute('aria-pressed',String(b===f)));document.querySelectorAll('.pub-entry').forEach(n=>n.hidden=f.dataset.pubFilter!=='all'&&n.dataset.pubcat!==f.dataset.pubFilter)}const t=e.target.closest('[data-timeline]');if(t){const data=JSON.parse(t.dataset.timeline);document.querySelectorAll('[data-timeline]').forEach(b=>b.setAttribute('aria-pressed',String(b===t)));document.getElementById('timelineResult').innerHTML=`<strong>${data.year} · ${data.title}</strong><span>${data.result}</span>`;document.getElementById('timelineModalDetail').textContent=data.result;document.getElementById('timelineModal').showModal()}if(e.target.closest('[data-close-dialog]'))document.getElementById('timelineModal').close();if(e.target.closest('[data-table-toggle]')){const t=document.querySelector('[data-data-table]');t.hidden=!t.hidden}});
  const progress=document.getElementById('scrollProgress');addEventListener('scroll',()=>{const m=document.documentElement.scrollHeight-innerHeight;progress.style.transform=`scaleX(${m?scrollY/m:0})`},{passive:true});
  function count(node){if(node.dataset.done)return;node.dataset.done='1';const target=Number(node.dataset.count);if(reduced){node.textContent=target.toLocaleString('en-US');return}const start=performance.now(),duration=1050;const frame=now=>{const p=Math.min(1,(now-start)/duration),value=Math.round(target*(1-Math.pow(1-p,3)));node.textContent=value.toLocaleString('en-US');if(p<1)requestAnimationFrame(frame)};requestAnimationFrame(frame)}
  const io=!reduced&&'IntersectionObserver'in window?new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('is-visible');e.target.querySelectorAll('[data-count]').forEach(count);io.unobserve(e.target)}}),{threshold:.12}):null;document.querySelectorAll('.reveal').forEach(n=>io?io.observe(n):n.classList.add('is-visible'));
  const visual=document.querySelector('[data-story-visual]');if(visual&&!reduced){const storyIo=new IntersectionObserver(es=>es.forEach(e=>{if(!e.isIntersecting)return;const n=Number(e.target.dataset.storyStep),step=storySteps[n-1];visual.dataset.step=String(n);visual.querySelector('.story-center span').textContent=`0${n}`;visual.querySelector('[data-story-center]').textContent=step[0];visual.querySelector('[data-story-note]').textContent=step[1]}),{threshold:.58,rootMargin:'-20% 0px -30% 0px'});document.querySelectorAll('[data-story-step]').forEach(n=>storyIo.observe(n))}
  if(!reduced)document.querySelectorAll('.card').forEach(card=>card.addEventListener('pointermove',e=>{const r=card.getBoundingClientRect();card.style.setProperty('--mx',`${e.clientX-r.left}px`);card.style.setProperty('--my',`${e.clientY-r.top}px`)}));
</script>
