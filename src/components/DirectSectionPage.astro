---
import type { Locale } from '../data/site';
import { documents, inline, sectionIds } from '../data/site';
import ContentBlocks from './ContentBlocks.astro';
import WorkCatalog from './WorkCatalog.astro';
import { withBase } from '../data/paths';
interface Props { lang: Locale; id: typeof sectionIds[number]; }
const { lang, id } = Astro.props;
const section = documents[lang].sections[sectionIds.indexOf(id)];
const catalogTitle = { en:'Browse the evidence trail', pt:'Explore a trilha de evidências', es:'Explora la ruta de evidencia', it:'Esplora il percorso dell’evidenza' }[lang];
const bookCoverAlt = { en:'Cover of “Governança em Tempo Real”', pt:'Capa de “Governança em Tempo Real”', es:'Portada de “Governança em Tempo Real”', it:'Copertina di “Governança em Tempo Real”' }[lang];
---
<article class="page-shell" id={id}>
  <header class:list={['section-shell', { 'book-copy': id === 'book' }]}><p class="eyebrow">{section.title}</p><h1 class="page-title">{section.title}</h1>{section.intro.map((line: string) => <p class="lede" set:html={inline(line)}></p>)}</header>
  {id === 'book' && <figure class="book-cover reveal"><img src={withBase('images/governanca-em-tempo-real-capa.png')} alt={bookCoverAlt} width="515" height="605" loading="lazy" /></figure>}
  {id === 'research' && <WorkCatalog lang={lang} categories={['research','policy']} title={catalogTitle} />}
  {id === 'tools' && <WorkCatalog lang={lang} categories={['tools']} title={catalogTitle} />}
  <section class:list={['section-shell', { 'book-copy': id === 'book' }]}><ContentBlocks section={section} /></section>
</article>
