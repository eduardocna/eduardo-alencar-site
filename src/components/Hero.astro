---
import type { Locale } from '../data/site';
import { landing } from '../data/landing';
import { localePath, withBase } from '../data/paths';
interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = landing[lang];
---
<section class="hero section-shell" aria-labelledby="hero-title">
  <div class="hero-copy reveal">
    <p class="eyebrow">Eduardo Alencar</p>
    <h1 id="hero-title">{t.heroTitle}</h1>
    <p class="hero-lede">{t.heroText}</p>
    <div class="ctarow">
      <a class="cta" href={localePath(lang, 'newsletter/')}>{t.ctaNewsletter}</a>
      <a class="cta ghost glass-btn" href={localePath(lang, 'book/')}>{t.ctaBook}</a>
    </div>
  </div>
  <div class="hero-stage reveal" aria-hidden="true">
    <div class="hero-orbit hero-orbit-a"></div>
    <div class="hero-orbit hero-orbit-b"></div>
    <div class="hero-particles">{Array.from({ length: 40 }).map((_, i) => <i style={`--i:${i};--ring:${i % 4};--tone:${i % 5}`}></i>)}</div>
    <img src={withBase('images/eduardo-alencar.jpg')} alt="" width="280" height="280" />
  </div>
  <a class="scroll-hint" href="#impact"><span>{lang === 'pt' ? 'Role para explorar' : lang === 'es' ? 'Desplázate para explorar' : lang === 'it' ? 'Scorri per esplorare' : 'Scroll to explore'}</span><i></i></a>
</section>
