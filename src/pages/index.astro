---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout title="Eduardo Alencar | Evidence Lab" description="Applied research, tools and evidence for public integrity.">
  <section class="hero"><div><p class="eyebrow">Eduardo Alencar · PhD · scholar-practitioner</p><h1>Public integrity, measured.</h1><p class="lede">Applied research, tools and evidence for integrity, governance and public-sector delivery.</p><div class="actions"><a class="button" href={`${base}en/`}>Enter in English</a><a class="button secondary" href={`${base}pt/`}>Entrar em português</a></div></div><aside class="hero-note"><strong>Evidence Lab</strong><p>Every material claim connects to a source, method, limitation, or public artifact.</p></aside></section>
</BaseLayout>
