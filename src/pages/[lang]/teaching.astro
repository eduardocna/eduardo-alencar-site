---
import BaseLayout from '../../layouts/BaseLayout.astro'; import DirectSectionPage from '../../components/DirectSectionPage.astro'; import { isLocale, locales } from '../../data/site';
export function getStaticPaths(){return locales.map((lang)=>({params:{lang}}));} const lang=isLocale(Astro.params.lang)?Astro.params.lang:'en';
const meta={en:['Teaching','Teaching in governance, regulation, methods and artificial intelligence.'],pt:['Docência','Docência em governança, regulação, métodos e inteligência artificial.'],es:['Docencia','Docencia en gobernanza, regulación, métodos e inteligencia artificial.'],it:['Didattica','Didattica su governance, regolazione, metodi e intelligenza artificiale.']}[lang];
---
<BaseLayout lang={lang} title={`${meta[0]} | Eduardo Alencar`} description={meta[1]} contentPath="teaching/"><DirectSectionPage lang={lang} id="teaching" /></BaseLayout>
