---
import BaseLayout from '../../layouts/BaseLayout.astro';
export function getStaticPaths() { return ['en', 'pt'].map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang === 'pt' ? 'pt' : 'en'; const pt = lang === 'pt';
---
<BaseLayout lang={lang} title={pt ? 'Docência | Eduardo Alencar' : 'Teaching | Eduardo Alencar'} description={pt ? 'Docência em governança, regulação, métodos e inteligência artificial.' : 'Teaching in governance, regulation, methods and artificial intelligence.'}>
  <section class="section"><p class="eyebrow">{pt ? 'Docência' : 'Teaching'}</p><h1 class="page-title">{pt ? 'Métodos que ajudam a decidir.' : 'Methods that help people decide.'}</h1><p class="lede">{pt ? 'Ensino governança pública, regulação, inteligência artificial e métodos quantitativos em programas profissionais e acadêmicos.' : 'I teach public governance, regulation, artificial intelligence and quantitative methods in professional and academic programs.'}</p></section>
  <section class="section"><div class="case-grid"><article class="case"><h3>{pt ? 'Atual' : 'Current'}</h3><p><strong>Unyleya</strong> · Liderança, Governança Pública e IA</p><p><strong>Gran Faculdade</strong> · Regulação, concessões, PPPs, IA e criptografia</p><p><strong>Enap</strong> · Governança pública para resultados</p></article><article class="case"><h3>UC Irvine</h3><p>{pt ? 'Teaching Assistant, 2018–2020: criminologia, estatística, desenho de pesquisa, análise de dados e White-Collar Crime.' : 'Teaching Assistant, 2018–2020: criminology, statistics, research design, data analysis and White-Collar Crime.'}</p></article></div></section>
  <section class="section"><h2>{pt ? 'Evidência de ensino' : 'Teaching evidence'}</h2><p>{pt ? 'A página pública apresentará somente síntese agregada e trechos anonimizados de avaliações da UC Irvine após revisão de privacidade. Os relatórios brutos permanecem no acervo interno.' : 'The public page will contain only aggregated summaries and anonymized UC Irvine feedback excerpts after privacy review. Raw reports remain in the internal archive.'}</p><p class="notice">{pt ? 'Disponível mediante solicitação: ementas e evidências adicionais que não exponham dados de alunos.' : 'Available on request: syllabi and additional evidence that does not expose student data.'}</p></section>
</BaseLayout>
