---
import BaseLayout from '../../layouts/BaseLayout.astro'; import WorkCatalog from '../../components/WorkCatalog.astro'; import { isLocale, locales } from '../../data/site';
export function getStaticPaths(){return locales.map((lang)=>({params:{lang}}));} const lang=isLocale(Astro.params.lang)?Astro.params.lang:'en';
const copy={en:['Public work','Research, policy products, tools and evidence.'],pt:['Produção pública','Pesquisa, produtos de política, ferramentas e evidências.'],es:['Producción pública','Investigación, productos de política, herramientas y evidencia.'],it:['Produzione pubblica','Ricerca, prodotti di policy, strumenti ed evidenze.']}[lang];
---
<BaseLayout lang={lang} title={`${copy[0]} | Eduardo Alencar`} description={copy[1]} contentPath="publications/"><article class="page-shell"><header class="section-shell"><p class="eyebrow">{copy[0]}</p><h1 class="page-title">{copy[0]}</h1><p class="lede">{copy[1]}</p></header><WorkCatalog lang={lang} /></article></BaseLayout>
