---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DirectSectionPage from '../../components/DirectSectionPage.astro';
import { isLocale, locales } from '../../data/site';
export function getStaticPaths() { return locales.map((lang) => ({ params: { lang } })); }
const lang = isLocale(Astro.params.lang) ? Astro.params.lang : 'en';
const meta = { en:['Evidence Lab','Tools, data and public evidence trails.'], pt:['Laboratório de evidências','Ferramentas, dados e trilhas públicas de evidência.'], es:['Laboratorio de evidencia','Herramientas, datos y rutas públicas de evidencia.'], it:['Laboratorio dell’evidenza','Strumenti, dati e percorsi pubblici di evidenza.'] }[lang];
---
<BaseLayout lang={lang} title={`${meta[0]} | Eduardo Alencar`} description={meta[1]} contentPath="evidence-lab/"><DirectSectionPage lang={lang} id="tools" /></BaseLayout>
