---
import BaseLayout from '../../layouts/BaseLayout.astro'; import DirectSectionPage from '../../components/DirectSectionPage.astro'; import { isLocale, locales } from '../../data/site';
export function getStaticPaths(){return locales.map((lang)=>({params:{lang}}));} const lang=isLocale(Astro.params.lang)?Astro.params.lang:'en';
const meta={en:['CV','Academic and professional trajectory.'],pt:['Currículo','Trajetória acadêmica e profissional.'],es:['CV','Trayectoria académica y profesional.'],it:['CV','Percorso accademico e professionale.']}[lang];
---
<BaseLayout lang={lang} title={`${meta[0]} | Eduardo Alencar`} description={meta[1]} contentPath="cv/"><DirectSectionPage lang={lang} id="cv" /></BaseLayout>
