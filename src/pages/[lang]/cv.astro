---
import BaseLayout from '../../layouts/BaseLayout.astro';
export function getStaticPaths() { return ['en', 'pt'].map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang === 'pt' ? 'pt' : 'en'; const pt = lang === 'pt';
---
<BaseLayout lang={lang} title={pt ? 'Currículo | Eduardo Alencar' : 'CV | Eduardo Alencar'} description={pt ? 'Trajetória acadêmica e profissional de Eduardo Alencar.' : 'Academic and professional trajectory of Eduardo Alencar.'}>
  <section class="section"><p class="eyebrow">Curriculum Vitae</p><h1 class="page-title">{pt ? 'Pesquisa, implementação e serviço público.' : 'Research, implementation and public service.'}</h1><p class="lede">{pt ? 'Doutor em Social Ecology pela University of California, Irvine, com experiência em governança, integridade, transformação digital e avaliação de políticas públicas.' : 'PhD in Social Ecology from the University of California, Irvine, with experience in governance, integrity, digital transformation and policy evaluation.'}</p><div class="actions"><a class="button" href="mailto:eduardocna@gmail.com?subject=CV%20request">{pt ? 'Solicitar CV completo' : 'Request full CV'}</a></div></section>
  <section class="section"><div class="case-grid"><article class="case"><h3>{pt ? 'Formação' : 'Education'}</h3><p>PhD and MA, Social Ecology · University of California, Irvine</p><p>Executive MBA · Fundação Getulio Vargas</p><p>BA Economics · Universidade de Brasília</p></article><article class="case"><h3>{pt ? 'Reconhecimentos' : 'Honors'}</h3><p>Best Pitch, ITU/UNU-MERIT (2024)</p><p>Outstanding Student Paper Award, American Society of Criminology (2022)</p><p>UCI fellowships and merit awards (2017–2023)</p></article><article class="case"><h3>{pt ? 'Serviço profissional' : 'Professional service'}</h3><p>Fraud Research Group, Aston University · IRU WG5 · U4SSC · peer review and editorial service.</p></article><article class="case"><h3>{pt ? 'Dados verificáveis' : 'Verifiable profiles'}</h3><p><a href="https://orcid.org/0000-0002-9218-1798">ORCID</a> · <a href="https://scholar.google.com/citations?user=vJ12isgAAAAJ">Google Scholar</a> · <a href="https://www.linkedin.com/in/eduardocna">LinkedIn</a></p></article></div></section>
</BaseLayout>
