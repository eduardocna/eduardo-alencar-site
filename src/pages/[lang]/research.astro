---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DirectSectionPage from '../../components/DirectSectionPage.astro';
import { isLocale, locales } from '../../data/site';
export function getStaticPaths() { return locales.map((lang) => ({ params: { lang } })); }
const lang = isLocale(Astro.params.lang) ? Astro.params.lang : 'en';
const meta = { en:['Research','Applied research on integrity and state capacity.'], pt:['Pesquisa','Pesquisa aplicada sobre integridade e capacidade estatal.'], es:['Investigación','Investigación aplicada sobre integridad y capacidad estatal.'], it:['Ricerca','Ricerca applicata su integrità e capacità statale.'] }[lang];
---
<BaseLayout lang={lang} title={`${meta[0]} | Eduardo Alencar`} description={meta[1]} contentPath="research/"><DirectSectionPage lang={lang} id="research" /></BaseLayout>
