---
import BaseLayout from '../../layouts/BaseLayout.astro'; import DirectSectionPage from '../../components/DirectSectionPage.astro'; import { isLocale, locales } from '../../data/site';
export function getStaticPaths(){return locales.map((lang)=>({params:{lang}}));} const lang=isLocale(Astro.params.lang)?Astro.params.lang:'en';
const meta={en:['Contact','Contact for research, speaking and collaboration.'],pt:['Contato','Contato para pesquisa, palestras e colaboração.'],es:['Contacto','Contacto para investigación, conferencias y colaboración.'],it:['Contatti','Contatti per ricerca, conferenze e collaborazione.']}[lang];
---
<BaseLayout lang={lang} title={`${meta[0]} | Eduardo Alencar`} description={meta[1]} contentPath="contact/"><DirectSectionPage lang={lang} id="contact" /></BaseLayout>
