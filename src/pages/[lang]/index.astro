---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNarrative from '../../components/SiteNarrative.astro';
import { copy, isLocale, locales } from '../../data/site';
export function getStaticPaths() { return locales.map((lang) => ({ params: { lang } })); }
const lang = isLocale(Astro.params.lang) ? Astro.params.lang : 'en';
const descriptions = { en: 'Public integrity, data, research, teaching and evidence-based government.', pt: 'Integridade pública, dados, pesquisa, docência e governo baseado em evidências.', es: 'Integridad pública, datos, investigación, docencia y gobierno basado en evidencia.', it: 'Integrità pubblica, dati, ricerca, didattica e governo basato sull’evidenza.' };
---
<BaseLayout lang={lang} title={`Eduardo Alencar | ${copy[lang].nav[0]}`} description={descriptions[lang]}><SiteNarrative lang={lang} /></BaseLayout>
