---
import '../styles/global.css';
import '../styles/narrative.css';
import { copy, locales, sectionIds, type Locale } from '../data/site';
interface Props { title: string; description: string; lang?: Locale; }
const { title, description, lang = 'en' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const local = (path: string) => `${base}${path.replace(/^\//, '')}`;
const ui = copy[lang];
const localeNames: Record<Locale, string> = { en: 'EN', pt: 'PT', es: 'ES', it: 'IT' };
const canonicalPath = `/${lang}/`;
---
<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(canonicalPath, Astro.site)} />
    {locales.map((locale) => <link rel="alternate" hreflang={locale} href={new URL(`/${locale}/`, Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL('/en/', Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title="Evidence notebook" href={local('/rss.xml')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#home">Skip to content</a>
    <header class="protobar">
      <a class="brand" href={local(`/${lang}/`)}>EA<span>·</span> Evidence Lab</a>
      <nav aria-label="Primary navigation">{sectionIds.map((id, index) => <a href={`#${id}`} data-page-link={id} aria-current={id === 'home' ? 'page' : 'false'}>{ui.nav[index]}</a>)}</nav>
      <div class="toolbar"><div class="langtoggle" aria-label="Language selector">{locales.map((locale) => <a href={local(`/${locale}/`)} aria-current={locale === lang ? 'page' : undefined} aria-label={locale === lang ? `${localeNames[locale]} selected` : localeNames[locale]}>{localeNames[locale]}</a>)}</div><button class="themebtn" id="themebtn" type="button">{ui.theme}</button></div>
    </header>
    <main><slot /></main>
    <footer>
      <p>© {new Date().getFullYear()} Eduardo Alencar · Brasília, Brazil</p>
      <p><a href="https://www.linkedin.com/in/eduardocna">LinkedIn</a> · <a href="https://orcid.org/0000-0002-9218-1798">ORCID</a> · <a href="https://scholar.google.com/citations?user=vJ12isgAAAAJ">Google Scholar</a> · <a href="mailto:eduardocna@gmail.com">Email</a></p>
    </footer>
    <script is:inline>{`const b=document.getElementById('themebtn');const labels=${JSON.stringify({ light: ui.theme, dark: lang==='pt'?'Visualização escura':lang==='es'?'Vista oscura':lang==='it'?'Vista scura':'Dark view' })};try{document.documentElement.dataset.theme=localStorage.getItem('eduardo-theme')||'dark'}catch{};b?.addEventListener('click',()=>{const root=document.documentElement;const light=root.dataset.theme==='light';root.dataset.theme=light?'dark':'light';try{localStorage.setItem('eduardo-theme',root.dataset.theme)}catch{};b.textContent=labels[root.dataset.theme]});if(b)b.textContent=labels[document.documentElement.dataset.theme]`}</script>
  </body>
</html>
