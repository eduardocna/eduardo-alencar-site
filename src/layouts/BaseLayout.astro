---
import '../styles/global.css';
interface Props { title: string; description: string; lang?: 'en' | 'pt'; }
const { title, description, lang = 'en' } = Astro.props;
const alternate = lang === 'pt' ? '/en/' : '/pt/';
const nav = lang === 'pt'
  ? [['Início', '/pt/'], ['Pesquisa', '/pt/research/'], ['Laboratório', '/pt/evidence-lab/'], ['Publicações', '/pt/publications/'], ['Docência', '/pt/teaching/'], ['CV', '/pt/cv/'], ['Textos', '/pt/writing/']]
  : [['Home', '/en/'], ['Research', '/en/research/'], ['Evidence Lab', '/en/evidence-lab/'], ['Publications', '/en/publications/'], ['Teaching', '/en/teaching/'], ['CV', '/en/cv/'], ['Writing', '/en/writing/']];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" hreflang={lang === 'pt' ? 'en' : 'pt'} href={new URL(alternate, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/en/', Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title="Evidence notebook" href="/rss.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#content">{lang === 'pt' ? 'Pular para o conteúdo' : 'Skip to content'}</a>
    <header class="site-header">
      <a class="brand" href={`/${lang}/`}>EA<span>·</span> Evidence Lab</a>
      <nav aria-label={lang === 'pt' ? 'Navegação principal' : 'Primary navigation'}>
        {nav.map(([label, href]) => <a href={href}>{label}</a>)}
      </nav>
      <a class="language" href={alternate}>{lang === 'pt' ? 'EN' : 'PT'}</a>
    </header>
    <main id="content"><slot /></main>
    <footer>
      <p>© {new Date().getFullYear()} Eduardo Alencar · Brasília, Brazil</p>
      <p><a href="https://www.linkedin.com/in/eduardocna">LinkedIn</a> · <a href="https://orcid.org/0000-0002-9218-1798">ORCID</a> · <a href="https://scholar.google.com/citations?user=vJ12isgAAAAJ">Google Scholar</a> · <a href="mailto:eduardocna@gmail.com">Email</a></p>
    </footer>
  </body>
</html>
